#!/usr/bin/env python3
"""Modal vault browser built on prompt_toolkit's real vi mode.

  j/k 3j gg G      move            y yank        e edit
  /  search        dd Y delete     r reveal      s resync
  q hide/quit  Q quit  ?  help

Backend: `bw serve` (official Bitwarden CLI's local REST API, localhost:8087)
— stdlib urllib only. At startup vault-tui unlocks the vault if needed and
pulls GET /list/object/items once; every entry is already plaintext, so the
in-memory cache is warm from the first frame, same as before. Writes
(edit/delete) patch the in-memory cache directly from the response, no
re-list needed; `s` syncs then re-lists.

The GET-modify-PUT round trip was verified to preserve every field,
including passkeys and the item's own key — edit() relies on that.
"""
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from collections import namedtuple

from prompt_toolkit.application import Application, run_in_terminal
from prompt_toolkit.buffer import Buffer
from prompt_toolkit.enums import EditingMode
from prompt_toolkit.filters import Condition
from prompt_toolkit.key_binding import KeyBindings
from prompt_toolkit.key_binding.vi_state import InputMode
from prompt_toolkit.layout import HSplit, Layout, VSplit, Window
from prompt_toolkit.layout.containers import ConditionalContainer, WindowAlign
from prompt_toolkit.layout.controls import BufferControl, FormattedTextControl
from prompt_toolkit.layout.dimension import D
from prompt_toolkit.layout.processors import BeforeInput
from prompt_toolkit.styles import Style

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
# Plaintext field cache — retired by in-process decryption. Only referenced
# now to delete a stale one left by a previous version (never written again).
FIELDS_JSON = os.path.join(tempfile.gettempdir(), "bwvault-fields.json")
MASK = ("password", "code", "ssn", "number", "totp")


# ── 1. bw serve client + unlock + vault loading — pure, no UI imports ──────

def run(argv, timeout=None, **kw):
    return subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, **kw)


BW_BASE = "http://localhost:8087"
BW_LOG = os.path.expanduser("~/Library/Logs/vault-tui-bw-serve.log")
PINENTRY_PATH = os.environ.get("VAULT_TUI_PINENTRY", "pinentry-mac")

Result = namedtuple("Result", "returncode stderr")
# Bypass any HTTP_PROXY/http_proxy env var — bw serve is always localhost,
# and the master password must never leave the machine via a proxy.
_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class BwError(Exception):
    """A `bw serve` call failed outright (network/HTTP/JSON), not a normal
    {"success": false} business response — callers see those as plain dicts."""


def api(method, path, body=None, timeout=10):
    """One HTTP round trip to `bw serve`. -> parsed JSON dict (whatever bw
    sends back, success or not). Raises BwError only when bw never answered
    with a JSON body at all (connection refused, timeout, garbage)."""
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"} if data is not None else {}
    req = urllib.request.Request(BW_BASE + path, data=data, method=method,
                                 headers=headers)
    try:
        with _OPENER.open(req, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as exc:
        try:
            return json.loads(exc.read().decode())
        except Exception:
            raise BwError(f"{method} {path}: HTTP {exc.code}")
    except urllib.error.URLError as exc:
        raise BwError(f"{method} {path}: {exc}")
    except (OSError, ValueError) as exc:
        # TimeoutError, RemoteDisconnected/ConnectionReset (raised by
        # getresponse()/read(), not wrapped in URLError), or a 200 response
        # that isn't valid JSON (ValueError via json.JSONDecodeError).
        raise BwError(f"{method} {path}: {exc}")


def call(method, path, body=None, timeout=10):
    """api() with one automatic unlock-and-retry if the vault was locked
    out from under us (e.g. vault-popup's lock-on-hide)."""
    r = api(method, path, body, timeout=timeout)
    if r.get("success") is False and r.get("message") == "Vault is locked.":
        ok, _email, _pw = unlock(offer_consent=False)
        if not ok:
            raise BwError("vault is locked and unlock failed or was cancelled")
        r = api(method, path, body, timeout=timeout)
    return r


def ensure_bw_serve(timeout=15):
    """`bw serve` not reachable -> spawn it detached and poll /status."""
    try:
        api("GET", "/status")
        return
    except BwError:
        pass
    os.makedirs(os.path.dirname(BW_LOG), exist_ok=True)
    try:
        with open(BW_LOG, "a") as log:
            subprocess.Popen(["bw", "serve", "--hostname", "localhost", "--port", "8087"],
                             stdout=log, stderr=subprocess.STDOUT,
                             start_new_session=True)
    except FileNotFoundError:
        raise BwError("`bw` CLI not found on PATH — install it (brew install bitwarden-cli)")
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            api("GET", "/status")
            return
        except BwError:
            time.sleep(0.3)
    raise BwError(f"bw serve did not come up within {timeout}s — see {BW_LOG}")


class PinentryCancelled(Exception):
    """User dismissed the pinentry prompt."""


def _assuan_escape(s):
    return s.replace("%", "%25").replace("\n", "%0A").replace("\r", "%0D")


def prompt_password(pinentry_path="pinentry-mac", desc="Unlock vault-tui",
                     prompt="Master password:"):
    """Drive pinentry's Assuan stdin/stdout protocol for one password.

    Never touches our own terminal (the TUI owns it). Raises
    PinentryCancelled if the user cancels; any protocol error surfaces as
    that too, so the caller has one exit path.
    """
    proc = subprocess.Popen([pinentry_path], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            text=True)
    try:
        def send(cmd):
            proc.stdin.write(cmd + "\n")
            proc.stdin.flush()
            lines = []
            while True:
                line = proc.stdout.readline()
                if not line:
                    raise PinentryCancelled("pinentry closed unexpectedly")
                line = line.rstrip("\n")
                if line.startswith("OK"):
                    return lines
                if line.startswith("ERR"):
                    raise PinentryCancelled(line)
                if line.startswith("D "):
                    lines.append(line[2:])
                # ignore S (status) / # (comment) lines

        proc.stdout.readline()  # initial greeting ("OK Pleased to meet you...")
        send(f"SETDESC {_assuan_escape(desc)}")
        send(f"SETPROMPT {_assuan_escape(prompt)}")
        data = send("GETPIN")
        pin = data[0] if data else ""
        try:
            send("BYE")
        except PinentryCancelled:
            pass
        return pin
    finally:
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            proc.kill()


NO_KEYCHAIN_MARKER = os.path.expanduser("~/.local/share/vault-tui/no-keychain")

# SECURITY NOTE: storing the master password in the Keychain means any
# process running as this user can read it straight back with the same
# `security find-generic-password -w` command — no prompt required, once
# the item's ACL allows this tool to read it. It's a deliberate trade — no
# prompt on a normal launch — made explicitly by answering "y" to the
# one-time consent prompt, not a hidden default.


def keychain_get(email, service="vault-tui"):
    """Read-only Keychain lookup: `security find-generic-password -w`.

    Never writes, adds, or deletes a Keychain item — read-only. ANY
    failure (item not found, user denies the access-control dialog,
    security(1) missing, non-zero exit) is a plain miss: return None,
    never fatal. The caller falls through to pinentry.
    """
    try:
        r = subprocess.run(
            ["security", "find-generic-password", "-s", service, "-a", email, "-w"],
            capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    pw = r.stdout.rstrip("\n")
    return pw or None


def keychain_set(email, password, service="vault-tui"):
    """Store the master password in the Keychain: `security add-generic-password`.

    Only called after the user explicitly consents (the TUI's one-time
    status-line prompt). `-U` updates in place if somehow already present.
    Never call security delete-generic-password from here or anywhere in
    this codebase — removal is the user's business, done by hand.
    Raises on failure; the caller must catch it and surface the error
    without treating it as fatal (the vault is already unlocked by then).
    """
    r = subprocess.run(
        ["security", "add-generic-password", "-s", service, "-a", email,
         "-w", password, "-D", "vault-tui master password", "-U"],
        capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or "security add-generic-password failed").strip())


def has_declined_keychain():
    return os.path.exists(NO_KEYCHAIN_MARKER)


def record_keychain_decline():
    """Write the marker that stops the save-to-Keychain prompt forever."""
    try:
        os.makedirs(os.path.dirname(NO_KEYCHAIN_MARKER), exist_ok=True)
        with open(NO_KEYCHAIN_MARKER, "w") as fh:
            fh.write("user declined Keychain storage for vault-tui\n")
    except OSError:
        pass  # best-effort; worst case it asks again next launch


def get_master_password(email, pinentry_path="pinentry-mac",
                         keychain_get_fn=keychain_get):
    """Keychain first, pinentry fallback. -> (password, from_keychain: bool).

    from_keychain tells the caller whether to offer the save-to-Keychain
    consent step at all (only relevant right after a pinentry unlock).
    Raises PinentryCancelled if the Keychain has nothing AND the pinentry
    prompt is cancelled/fails — that's the single exit path callers need
    to handle. keychain_get_fn is injectable so --check never touches the
    real Keychain.
    """
    pw = keychain_get_fn(email)
    if pw:
        return pw, True
    pw = prompt_password(pinentry_path, desc=f"Unlock vault for {email}",
                         prompt="Master password")
    return pw, False


HIDDEN_PREFIX = "\x00hidden\x00"   # internal marker, stripped before display


def is_hidden(label):
    """True if this row came from a Bitwarden hidden (type 1) custom field."""
    return label.startswith(HIDDEN_PREFIX)


def strip_hidden(label):
    return label[len(HIDDEN_PREFIX):] if is_hidden(label) else label


def unlock(offer_consent=False):
    """Keychain first, pinentry fallback, 3 attempts; POST /unlock.

    No prompt on a normal launch once the Keychain item exists (account =
    the email bw serve's own /status reports). A prompt appears only when
    that lookup misses, and it names the account being unlocked so it's
    never ambiguous which of several similar addresses this is for.

    -> (True, email, pw_for_consent) once unlocked (or already unlocked),
    or (False, None, None) if the user cancelled the pinentry prompt or
    3 attempts were all wrong. pw_for_consent is non-None only when
    offer_consent=True, the password came from pinentry (not Keychain),
    and the user hasn't already declined Keychain storage — see
    _offer_keychain_save(). It is held only long enough for the caller to
    hand it to that one-time prompt.
    """
    status = api("GET", "/status")
    tmpl = status.get("data", {}).get("template", {})
    email = tmpl.get("userEmail") or ""
    if tmpl.get("status") == "unlocked":
        return True, email, None

    use_keychain = True
    for attempt in range(3):
        try:
            pw, from_keychain = get_master_password(
                email, pinentry_path=PINENTRY_PATH,
                keychain_get_fn=(keychain_get if use_keychain
                                 else (lambda _e: None)))
        except PinentryCancelled:
            return False, None, None
        r = api("POST", "/unlock", {"password": pw})
        if r.get("success"):
            pw_for_consent = None
            if offer_consent and not from_keychain and not has_declined_keychain():
                pw_for_consent = pw
            pw = None
            return True, email, pw_for_consent
        pw = None
        if from_keychain:
            # A stale Keychain entry must not lock the user out: skip it on
            # the retry so they get a real prompt instead of the same bad
            # password three times.
            use_keychain = False
            sys.stderr.write("keychain password rejected — prompting\n")
        else:
            sys.stderr.write(f"wrong master password for {email}\n")
    sys.stderr.write(f"could not unlock {email} after 3 attempts\n")
    return False, None, None


LOGIN = [("username", "username"), ("password", "password"), ("totp", "totp")]
CARD = [("cardholderName", "cardholder name"), ("brand", "brand"),
        ("number", "number"), ("code", "code"),
        ("expMonth", "exp month"), ("expYear", "exp year")]
IDENT = [("title", "title"), ("firstName", "first name"),
         ("middleName", "middle name"), ("lastName", "last name"),
         ("username", "username"), ("email", "email"), ("phone", "phone"),
         ("address1", "address1"), ("address2", "address2"),
         ("address3", "address3"), ("city", "city"), ("state", "state"),
         ("postalCode", "postal code"), ("country", "country"),
         ("ssn", "ssn"), ("licenseNumber", "license number"),
         ("passportNumber", "passport number")]
TYPE_SECTIONS = {1: ("login", LOGIN), 3: ("card", CARD), 4: ("identity", IDENT)}


def _rows_from_item(item, folder_map):
    """One bw item (already plaintext) -> [(label, value), ...].

    Same labels/order every view expects: LOGIN/CARD/IDENT keys in order,
    then uris, then custom fields (hidden ones tagged with HIDDEN_PREFIX),
    then folder name, then notes.
    """
    rows = []
    inner_key, keys = TYPE_SECTIONS.get(item.get("type"), (None, []))
    inner = (item.get(inner_key) or {}) if inner_key else {}
    seen = set()
    for jkey, label in keys:
        if jkey in seen:
            continue
        seen.add(jkey)
        v = inner.get(jkey)
        if v is not None and str(v).strip():
            rows.append((label, str(v)))

    for u in inner.get("uris") or []:
        uri = (u or {}).get("uri")
        if uri and str(uri).strip():
            rows.append(("uri", uri))

    for f in item.get("fields") or []:
        label = f.get("name") or "field"
        val = f.get("value")
        if val is not None and str(val).strip():
            if f.get("type") == 1:
                label = HIDDEN_PREFIX + label
            rows.append((label, str(val)))

    folder_name = folder_map.get(item.get("folderId"))
    if folder_name:
        rows.append(("folder", folder_name))

    notes = item.get("notes")
    if notes and str(notes).strip():
        rows.append(("notes", notes.replace("\n", "  ⏎  ")))

    return rows


def build_cache(items, folder_map):
    """-> ({(name, user): [(label, value), ...]}, {(name, user): item_id}).

    Keyed by (name, user) to match the existing cache contract. On a
    (name, user) collision (rare: two items can share both), the later
    item wins, same as the old decrypt_all()-driven cache did.
    """
    cache, id_map = {}, {}
    for item in items:
        name = item.get("name") or ""
        rows = _rows_from_item(item, folder_map)
        user = next((v for label, v in rows if label == "username"), "")
        key = (name, user)
        cache[key] = rows
        id_map[key] = item.get("id")
    return cache, id_map


def load_vault(offer_consent=False):
    """-> (cache, id_map, email, pw_for_consent) or None if unlock was
    cancelled/failed. See unlock() for pw_for_consent's one carve-out.

    Also refreshes the module-level FOLDER_MAP — _patch_after_write() reuses
    it so a single edited item can be re-rendered without a full re-list.
    """
    global FOLDER_MAP
    ok, email, pw_for_consent = unlock(offer_consent=offer_consent)
    if not ok:
        return None
    items_r = call("GET", "/list/object/items")
    if not items_r.get("success"):
        raise BwError(items_r.get("message") or "list items failed")
    folders_r = call("GET", "/list/object/folders")
    if not folders_r.get("success"):
        raise BwError(folders_r.get("message") or "list folders failed")
    items = items_r.get("data", {}).get("data") or []
    folders = folders_r.get("data", {}).get("data") or []
    folder_map = {f.get("id"): f.get("name") for f in folders if f.get("id")}
    FOLDER_MAP = folder_map
    cache, id_map = build_cache(items, folder_map)
    return cache, id_map, email, pw_for_consent


def fetch_totp(key):
    """Current TOTP code for (name, user) via GET /object/totp/<id> — the
    stored seed (in `cache`) is not a usable code, this is."""
    item_id = ID_MAP.get(key)
    if not item_id:
        return None
    try:
        r = call("GET", f"/object/totp/{item_id}")
    except BwError:
        return None
    return r.get("data", {}).get("data") if r.get("success") else None


def _editor_argv(path):
    editor = os.environ.get("EDITOR", "nvim")
    parts = editor.split() or ["nvim"]
    if os.path.basename(parts[0]) in ("vim", "nvim"):
        return parts + ["-n", path]   # no swapfile — temp dir, one-shot edit
    return parts + [path]


async def edit(key):
    """GET the item, open it as pretty JSON in $EDITOR, PUT it back.

    All fields are editable. Invalid JSON on save -> status error, nothing
    is PUT.

    async + `await run_in_terminal(...)`: the key binding below is itself
    async, so prompt_toolkit schedules it as a background task instead of
    calling it inline — without the await, edit() would race ahead and read
    the temp file back before the editor process had even started.
    """
    item_id = ID_MAP.get(key)
    if not item_id:
        state.status = "edit failed: unknown item"
        return
    try:
        r = call("GET", f"/object/item/{item_id}")
    except BwError as exc:
        state.status = f"edit failed: {exc}"
        return
    if not r.get("success"):
        state.status = f"edit failed: {r.get('message', 'unknown error')}"
        return

    original_text = json.dumps(r["data"], indent=2)
    tmpdir = tempfile.mkdtemp()
    os.chmod(tmpdir, 0o700)
    path = os.path.join(tmpdir, "item.json")
    try:
        with open(path, "w") as fh:
            fh.write(original_text)
        argv = _editor_argv(path)
        env = dict(os.environ)
        env.setdefault("EDITOR", "nvim")
        await run_in_terminal(lambda: subprocess.run(argv, env=env))

        with open(path) as fh:
            new_text = fh.read()
        if new_text == original_text:
            state.status = "edit: no change"
            return
        try:
            new_item = json.loads(new_text)
        except Exception as exc:
            state.status = f"edit failed: invalid JSON ({exc})"
            return

        pr = call("PUT", f"/object/item/{item_id}", new_item)
        if not pr.get("success"):
            state.status = f"edit failed: {pr.get('message', 'unknown error')}"
            return
        _patch_after_write(key, item_id, pr.get("data") or new_item)
        state.status = "saved"
    except BwError as exc:
        state.status = f"edit failed: {exc}"
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def remove(key):
    item_id = ID_MAP.get(key)
    if not item_id:
        return Result(1, "unknown item")
    try:
        r = call("DELETE", f"/object/item/{item_id}")
    except BwError as exc:
        return Result(1, str(exc))
    if r.get("success"):
        return Result(0, "")
    return Result(1, r.get("message") or "delete failed")


def sync():
    """POST /sync. -> True on success; on failure sets state.status and
    returns False so the caller doesn't overwrite that message."""
    try:
        r = call("POST", "/sync", timeout=30)  # ~1200 items can be slow
    except BwError as exc:
        state.status = f"sync failed: {exc}"
        return False
    if not r.get("success"):
        state.status = f"sync failed: {r.get('message', 'unknown error')}"
        return False
    return True


UNNAMED = "(unnamed)"


def display_name(name):
    """Render an entry's real (possibly empty) name for the UI.

    A bw item's name can genuinely be an empty string — that's a valid
    entry, not missing data, so it must never be dropped or mistaken for a
    failure. Never strip the real name for lookups; this is a
    display-only substitution.
    """
    return name if name.strip() else UNNAMED


def entries_from_cache(cache):
    """decrypt_all()'s cache -> frecency-ranked (name, user, folder) rows.

    The cache comes from build_cache(), already current from the last
    GET /list/object/items — always free, never a separate stale list.
    folder isn't tracked per-key here, so it's left blank — unused by
    ranking or the list view beyond the search-filter string.

    Every key in `cache` is a real item build_cache() produced, so nothing
    here is re-filtered by name content. An empty/whitespace name is fed
    through vault-frecency AS ITSELF (the real cache key, never rewritten),
    and only display_name() substitutes UNNAMED for showing it —
    state.selected()[:2] must keep matching the actual (name, user) key
    fields.get() looks up.
    """
    lines = "\n".join(f"{name}\t{user}\t" for name, user in cache)
    ranked = run([os.path.join(BIN, "vault-frecency"), "rank"], input=lines)
    seen = set(cache.keys())
    out = []
    for line in (ranked.stdout or lines).splitlines():
        p = line.split("\t")
        if len(p) < 2:
            continue
        name, user = p[0], p[1]
        if (name, user) not in seen:
            continue    # a genuinely blank ranker line, not a real entry
        seen.discard((name, user))
        out.append((name, user, p[2] if len(p) > 2 else ""))
    # Anything vault-frecency's ranker dropped (e.g. it also filters blank
    # names) still gets a row — real entries are never silently discarded.
    for name, user in seen:
        out.append((name, user, ""))
    return out


def bump(key):
    subprocess.Popen([os.path.join(BIN, "vault-frecency"), "bump", *key],
                      start_new_session=True)


# ── 2. Fields — wholesale warm cache, no worker ─────────────────────────────
#
# decrypt_all() at startup populates .cache for every entry in one shot
# (~8ms for 1218 entries). No hydration cursor, no cold/fetching markers,
# no background thread: every entry is warm from the first frame. The class
# shape (.get/.wait/.invalidate/.clear/.active_key/.last_error/
# .hydrate_paused) is kept because the render/key-binding call sites read
# it — but .wait() and .get() are now the same synchronous dict lookup, and
# .active_key/.hydrate_paused are permanently inert (kept so list_view()'s
# "cold/fetching" marker logic, unchanged below, still has something to read).


class Fields:
    def __init__(self, seed=None):
        self.cache = dict(seed or {})
        self.active_key = None     # never set: nothing fetches asynchronously
        self.last_error = {}       # kept for the field_view() error-row path
        self.hydrate_paused = False

    def get(self, key):
        return self.cache.get(key)

    def wait(self, key, timeout=10):
        return self.cache.get(key)

    def invalidate(self, key):
        self.cache.pop(key, None)

    def clear(self, seed=None):
        self.cache = dict(seed or {})


# ── 3. clipboard ─────────────────────────────────────────────────────────────

def copy(text):
    subprocess.run(["pbcopy"], input=text, text=True)

    def clear_if_unchanged():
        try:
            cur = run(["pbpaste"]).stdout
        except Exception:
            return
        if cur == text:
            subprocess.run(["pbcopy"], input="", text=True)

    t = threading.Timer(30, clear_if_unchanged)
    t.daemon = True
    t.start()


# ── 4. state ─────────────────────────────────────────────────────────────────

SCROLLOFF = 3


class State:
    def __init__(self, entries):
        self.entries = entries
        self.rows = []
        self.cursor = 0
        self.top = 0               # first visible row index (viewport)
        self.focus = "list"       # "list" | "fields"
        self.fidx = 0
        self.revealed = set()     # {(name, user, label)}
        self.pending_delete = None
        self.status = ""
        self.help = False
        # search_buffer is the query's real store (a prompt_toolkit Buffer in
        # vi mode, wired in build_app()); this starts empty and stays in sync
        # via on_text_changed -> refilter(), so `query` always reads live.
        self.search_buffer = None
        self.input_target = "search"   # where INSERT keystrokes land
        self.field_query = ""          # `/` search inside the open entry
        self.awaiting_keychain_consent = False   # y/N status-line prompt
        self.refilter()            # rows is assigned only here

    @property
    def query(self):
        return self.search_buffer.text if self.search_buffer else ""

    def refilter(self):
        """The ONLY place `rows` is assigned. Clamps cursor, resets fidx."""
        if not self.query:
            self.rows = self.entries
        else:
            q = self.query.lower()
            self.rows = [e for e in self.entries
                         if q in (e[0] + " " + e[1] + " " + e[2]).lower()]
        self.cursor = min(self.cursor, max(0, len(self.rows) - 1))
        self.fidx = 0
        self.pending_delete = None
        self.top = min(self.top, max(0, len(self.rows) - 1))
        self.follow_viewport()

    def follow_viewport(self, height=None):
        """Keep cursor visible with SCROLLOFF margin. Clamps `top`."""
        n = len(self.rows)
        h = height if height is not None else list_height()
        if h <= 0 or n <= h:
            self.top = 0
            return
        lo = self.cursor - h + 1 + SCROLLOFF
        hi = self.cursor - SCROLLOFF
        if self.top < lo:
            self.top = lo
        if self.top > hi:
            self.top = hi
        self.top = max(0, min(self.top, n - h))

    def selected(self):
        if self.rows and self.cursor < len(self.rows):
            return self.rows[self.cursor]
        return None


# ── 5. views — pure over (state, cache); display transforms live here ──────

def masked(label, value, revealed_key, revealed):
    """Mask a field's value unless the user revealed it with `r`.

    A Bitwarden hidden (type 1) custom field is masked because the vault
    says so; everything else falls back to the label heuristic, which
    covers built-ins like password/totp/card code that carry no type.
    """
    if revealed_key in revealed:
        return value
    if is_hidden(label):
        return "•" * 8
    if any(m in label.lower() for m in MASK):
        return "•" * 8
    return value


def collapse(value):
    return value.replace("\n", "⏎")


LAST_USED = {}          # (name, user) -> epoch seconds of most recent use


def load_last_used():
    """Most-recent-use timestamp per entry, from the frecency store.

    Same file vault-frecency writes; keys are tab-joined there. Missing or
    corrupt is not fatal — the column just renders blank.
    """
    path = os.path.expanduser("~/.local/share/vault-frecency.json")
    try:
        with open(path) as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        return {}                       # no uses recorded yet — expected
    except Exception as exc:            # corrupt file, bad import, etc.
        sys.stderr.write(f"last-used column unavailable: {exc!r}\n")
        return {}
    out = {}
    for joined, stamps in raw.items():
        if not stamps:
            continue
        name, _, user = joined.partition("\t")
        out[(name, user)] = max(stamps)
    return out


def ago(ts):
    """Compact relative age: 3m, 5h, 2d, 6w. Blank when never used."""
    if not ts:
        return ""
    d = time.time() - ts
    if d < 60:
        return "now"
    for span, suffix in ((3600, "m"), (86400, "h"), (604800, "d"), (None, "w")):
        if span is None:
            return f"{int(d // 604800)}w"
        if d < span:
            prev = {"m": 60, "h": 3600, "d": 86400}[suffix]
            return f"{int(d // prev)}{suffix}"
    return ""


def list_view(state, fields):
    h = list_height()
    if h > 0:
        state.follow_viewport(h)
        window = list(enumerate(state.rows))[state.top:state.top + h]
    else:
        window = list(enumerate(state.rows))
    out = []
    for i, (name, user, _folder) in window:
        style = "class:sel" if (i == state.cursor and state.focus == "list") \
            else ("class:cur" if i == state.cursor else "")
        key = (name, user)
        # No cold/fetching marker: decrypt_all() warms every entry up front,
        # so there is no async state left for a row to be "in" here.
        used = ago(LAST_USED.get(key))
        shown_name = display_name(name).strip()
        out.append((style,
                    f" {used:>4} {shown_name[:24]:<24} {user[:16]:<16}\n"))
    if not out:
        msg = "vault empty — run vault-warm" if not state.entries else "(no matches)"
        return [("", f"  {msg}\n")]
    return out


def consent_modal(email):
    """Centred, unmissable Keychain-save question."""
    pad = "   "
    return [
        ("", "\n\n"),
        ("class:modal", f"{pad}┌────────────────────────────────────────────┐\n"),
        ("class:modal", f"{pad}│  Save master password to the Keychain?     │\n"),
        ("class:modal", f"{pad}│                                            │\n"),
        ("class:modal", f"{pad}│  {email[:40]:<40}  │\n"),
        ("class:modal", f"{pad}│                                            │\n"),
        ("class:modal", f"{pad}│  Unlocks silently on every future launch.  │\n"),
        ("class:modal", f"{pad}│  Any process running as you could read it. │\n"),
        ("class:modal", f"{pad}│                                            │\n"),
        ("class:modalkey", f"{pad}│   y  save      n  never ask      esc later │\n"),
        ("class:modal", f"{pad}└────────────────────────────────────────────┘\n"),
    ]


def field_view(state, fields):
    cur = state.selected()
    if not cur:
        return [("", "")]
    key = cur[:2]
    rows = fields.get(key) or fields.last_error.get(key)
    out = [("class:title", f" {display_name(cur[0]).strip()}\n\n")]
    if rows is None:
        out.append(("class:dim", " loading…\n"))
        return out
    if rows and rows[0][0] in ("ERROR", "error"):
        # A failed decrypt must not look like an empty entry. Say what broke
        # and what to do — "(no fields)" hid an invalid-mac failure across
        # the whole vault once.
        out.append(("class:status", f" ⚠ {rows[0][1]}\n\n"))
        out.append(("class:dim", " entry could not be read — it is NOT deleted.\n"
                                 " try:  s  to resync\n"))
        return out
    if not rows:
        out.append(("class:dim", " (no fields)  — entry has no readable data\n"))
        return out
    for j, (label, value) in enumerate(rows):
        rkey = (key[0], key[1], label)
        shown = collapse(masked(label, value, rkey, state.revealed))
        # The hidden marker is internal: strip it for display, and flag the
        # row so it is obvious WHY it is masked.
        disp = strip_hidden(label)
        if is_hidden(label):
            disp = disp[:13] + " ⋯" if len(disp) > 13 else disp + " ⋯"
        style = "class:sel" if (j == state.fidx and state.focus == "fields") else ""
        out.append(("class:key", f" {disp:<15}"))
        out.append((style, f"{shown[:44]}\n"))
    return out


HELP = [
    ("class:title", " KEYS\n\n"),
    ("class:key", " MOVE\n"),
    ("", "  j / k          down / up   (3j = 3 down)\n"
         "  gg / G         top / bottom\n"
         "  l / enter      focus fields pane\n"
         "  h / esc        back to list\n\n"),
    ("class:key", " SCROLL\n"),
    ("", "  ctrl-d/u       half page down / up\n"
         "  ctrl-f/b       full page down / up\n"
         "  ctrl-e/y       scroll one line (cursor stays put)\n"
         "  zz / zt / zb   center / top / bottom cursor line\n"
         "  H / M / L      cursor to top / mid / bottom of view\n\n"),
    ("class:key", " SEARCH\n"),
    ("", "  /              search (insert mode)\n"
         "  esc / enter    leave search, keep filter\n"
         "  dd             clear the filter\n\n"),
    ("class:key", " ACTIONS\n"),
    ("", "  y              yank password, or selected field\n"
         "  r              reveal a masked field\n"
         "  e              edit  (all fields, via $EDITOR)\n"
         "  dd then Y      delete entry\n"
         "  s              force sync\n\n"),
    ("class:key", " EXIT\n"),
    ("", "  q              hide popup (alt-p to reopen); quit outside popup\n"
         "  Q              quit\n"
         "  ?              toggle this help\n"),
]


def help_view():
    return HELP


def search_label(state, app):
    """Left badge: which target is active. SEARCH blue / IN ENTRY yellow."""
    insert = app and app.vi_state.input_mode == InputMode.INSERT
    in_field = state.input_target == "field_search"
    typing = insert and not in_field
    if in_field:
        return [("class:fieldon", " IN ENTRY ")]
    return [("class:searchon" if typing else "class:dim",
              " SEARCH " if typing else "    /    ")]


def search_field_text(state, app):
    """Right-hand side of the bar when target is field_search (plain string)."""
    insert = app and app.vi_state.input_mode == InputMode.INSERT
    caret = "\u2588" if insert else ""
    return [("class:query", f" /{state.field_query}{caret}"),
            ("class:dim", f"   {display_name(state.rows[state.cursor][0]).strip()[:28]}"
             if state.rows else "")]


def search_count(state):
    """Right badge: match count, shown next to the real search Buffer."""
    return [("class:dim", f"   {len(state.rows)}/{len(state.entries)}")]


def status_view(state, app, fields):
    mode = "INSERT" if (app and app.vi_state.input_mode == InputMode.INSERT) \
        else "NORMAL"
    left = f" {mode} "
    info = ""
    msg = state.status
    if not msg and fields.hydrate_paused:
        msg = "vault locked — press s to resync (will prompt to unlock)"
    return [("class:mode" if mode == "NORMAL" else "class:imode", left),
            ("class:dim", info + "   "),
            ("class:status", msg or ""),
            ("class:dim", "" if msg else
             "? help   esc normal   y yank   dd clear search   q close")]


# ── module-level wiring (main() populates these before app.run()) ──────────

state = None
fields = None
_app = None
list_window = None      # the list pane's Window — focus target on esc/enter
ID_MAP = {}              # (name, user) -> bw item id; (re)built by load_vault()
FOLDER_MAP = {}          # folderId -> name; (re)built by load_vault()


def get_app():
    return _app


CHROME_ROWS = 2   # bar (1) + status (1); list pane fills the rest


def list_height():
    """Visible row count for the list pane, or 0 if not renderable yet.

    Uses the terminal size from the running Application's output, minus the
    fixed-height bar/status rows — simplest source of truth available: no
    extra Window/ScrollablePane machinery, no second layout pass. Callable
    outside a running app (e.g. --check) returns 0, which callers treat as
    "unknown, don't clip."
    """
    app = get_app()
    if app is None:
        return 0
    try:
        rows = app.output.get_size().rows
    except Exception:
        return 0
    return max(0, rows - CHROME_ROWS)


# ── 6. keys ──────────────────────────────────────────────────────────────────

kb = KeyBindings()
awaiting_consent = Condition(lambda: state is not None
                             and state.awaiting_keychain_consent)
nav = Condition(lambda: _app is not None
                and _app.vi_state.input_mode == InputMode.NAVIGATION
                and not (state is not None and state.awaiting_keychain_consent))
ins = Condition(lambda: _app is not None
                and _app.vi_state.input_mode == InputMode.INSERT)
# field_search is a plain string (not a Buffer), so its typing/backspace/esc
# still need hand-rolled handlers. These must NOT fire for input_target ==
# "search" — that target is now a real focused Buffer, and prompt_toolkit's
# own default vi bindings (registered on the Application, gated by
# buffer_has_focus) need to see those keys instead, or motions like dw/cw
# never reach it. `kb` is global — it merges with the focused control's own
# bindings regardless of layout focus — so this filter is the only gate.
ins_field = Condition(lambda: _app is not None
                      and _app.vi_state.input_mode == InputMode.INSERT
                      and state is not None
                      and state.input_target == "field_search")


def _clear_pending():
    state.pending_delete = None


@kb.add("c-j")
def _(event):
    if state.focus == "list":
        state.cursor = min(state.cursor + 1, max(0, len(state.rows) - 1))
        state.follow_viewport()
    else:
        rows = fields.get(state.selected()[:2]) if state.selected() else None
        state.fidx = min(state.fidx + 1, max(0, len(rows or []) - 1))


@kb.add("c-k")
def _(event):
    if state.focus == "list":
        state.cursor = max(state.cursor - 1, 0)
        state.follow_viewport()
    else:
        state.fidx = max(state.fidx - 1, 0)


@kb.add("j", filter=nav)
def _(event):
    _clear_pending()
    n = event.arg or 1
    if state.focus == "list":
        state.cursor = min(state.cursor + n, max(0, len(state.rows) - 1))
        state.follow_viewport()
    else:
        rows = fields.get(state.selected()[:2]) if state.selected() else None
        state.fidx = min(state.fidx + n, max(0, len(rows or []) - 1))


@kb.add("k", filter=nav)
def _(event):
    _clear_pending()
    n = event.arg or 1
    if state.focus == "list":
        state.cursor = max(state.cursor - n, 0)
        state.follow_viewport()
    else:
        state.fidx = max(state.fidx - n, 0)


@kb.add("g", "g", filter=nav)
def _(event):
    _clear_pending()
    state.cursor = 0
    state.follow_viewport()


@kb.add("G", filter=nav)
def _(event):
    _clear_pending()
    state.cursor = max(0, len(state.rows) - 1)
    state.follow_viewport()


# ── vi scroll bindings (issue #11) — all list-focused, filter=nav ──────────

def _page(n):
    """Move cursor by n rows (viewport-relative), clamp, follow."""
    state.cursor = max(0, min(state.cursor + n, max(0, len(state.rows) - 1)))
    state.follow_viewport()


@kb.add("c-d", filter=nav)
def _(event):
    _clear_pending()
    _page(max(1, list_height() // 2) or 1)


@kb.add("c-u", filter=nav)
def _(event):
    # NORMAL-mode ctrl-u: was "clear the filter" (issue #10 left this as the
    # swap point); issue #11 reassigns it to half-page-up scroll. The search
    # Buffer's own ctrl-u (unix-line-discard, prompt_toolkit native) is
    # untouched — it only fires while that Buffer has focus (INSERT mode),
    # never here.
    _clear_pending()
    _page(-(max(1, list_height() // 2) or 1))


@kb.add("c-f", filter=nav)
def _(event):
    _clear_pending()
    _page(max(1, list_height()) or 1)


@kb.add("c-b", filter=nav)
def _(event):
    _clear_pending()
    _page(-(max(1, list_height()) or 1))


@kb.add("c-e", filter=nav)
def _(event):
    """Scroll one line down; cursor stays put unless pushed off-screen."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or n <= h:
        return
    state.top = min(state.top + 1, max(0, n - h))
    if state.cursor < state.top + SCROLLOFF:
        state.cursor = min(state.top + SCROLLOFF, n - 1)
    state.follow_viewport()


@kb.add("c-y", filter=nav)
def _(event):
    """Scroll one line up; cursor stays put unless pushed off-screen."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or n <= h:
        return
    state.top = max(state.top - 1, 0)
    if state.cursor > state.top + h - 1 - SCROLLOFF:
        state.cursor = max(state.top + h - 1 - SCROLLOFF, 0)
    state.follow_viewport()


@kb.add("z", "z", filter=nav)
def _(event):
    """Center the cursor line in the viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor - h // 2, max(0, n - h)))


@kb.add("z", "t", filter=nav)
def _(event):
    """Cursor line to top of viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor, max(0, n - h)))


@kb.add("z", "b", filter=nav)
def _(event):
    """Cursor line to bottom of viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor - h + 1, max(0, n - h)))


@kb.add("H", filter=nav)
def _(event):
    """Cursor to the high (top, +scrolloff) row of the viewport."""
    _clear_pending()
    h = list_height()
    if h <= 0 or not state.rows:
        return
    state.cursor = min(state.top + SCROLLOFF, len(state.rows) - 1) \
        if state.top > 0 else state.top


@kb.add("M", filter=nav)
def _(event):
    """Cursor to the middle row of the viewport."""
    _clear_pending()
    h = list_height()
    if h <= 0 or not state.rows:
        return
    visible = min(h, len(state.rows) - state.top)
    state.cursor = min(state.top + visible // 2, len(state.rows) - 1)


@kb.add("L", filter=nav)
def _(event):
    """Cursor to the low (bottom, -scrolloff) row of the viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or not n:
        return
    bottom = min(state.top + h - 1, n - 1)
    state.cursor = max(bottom - SCROLLOFF, state.top) if bottom < n - 1 else bottom


_seen_this_session = set()


def _note_open(key):
    """Count opening an entry as usage, once per key per session."""
    if key not in _seen_this_session:
        _seen_this_session.add(key)
        bump(key)


@kb.add("l", filter=nav)
@kb.add("enter", filter=nav)
def _(event):
    cur = state.selected()
    if cur:
        state.focus = "fields"
        state.fidx = 0
        _note_open(cur[:2])


@kb.add("h", filter=nav)
@kb.add("escape", filter=nav)
def _(event):
    state.focus = "list"


def _enter_search(event, pos="keep", clear=False):
    """Put the caret back in the search line (vi insert-entry keys).

    pos: "keep" (i), "after" (a), "end" (A), "start" (I).
    """
    state.focus = "list"
    state.input_target = "search"
    buf = state.search_buffer
    if clear:
        buf.text = ""          # .text=, not .reset() — reset skips on_text_changed
    if pos == "end":
        buf.cursor_position = len(buf.text)
    elif pos == "start":
        buf.cursor_position = 0
    elif pos == "after":
        buf.cursor_position = min(buf.cursor_position + 1, len(buf.text))
    event.app.layout.focus(buf)
    event.app.vi_state.input_mode = InputMode.INSERT


@kb.add("i", filter=nav)
def _(event):
    """Insert at the cursor."""
    _enter_search(event, pos="keep")


@kb.add("a", filter=nav)
def _(event):
    """Append after the cursor."""
    _enter_search(event, pos="after")


@kb.add("A", filter=nav)
def _(event):
    """Append at end of line."""
    _enter_search(event, pos="end")


@kb.add("I", filter=nav)
def _(event):
    """Insert at the start of the line."""
    _enter_search(event, pos="start")


@kb.add("c", "c", filter=nav)
@kb.add("S", filter=nav)
def _(event):
    """Change the whole query: clear it and start typing."""
    _enter_search(event, pos="end", clear=True)


@kb.add("y", filter=nav)
def _(event):
    cur = state.selected()
    if not cur:
        return
    key = cur[:2]
    # Everything is warmed into `fields` at startup, so there's no cold-yank
    # wait left to announce here — fields.get()/.wait() is a plain dict hit.
    # TOTP is the one exception: the cached value is the stored seed, not a
    # usable code, so yanking it fetches the current code from bw serve.
    if state.focus == "fields":
        rows = fields.wait(key) or []
        if not rows or state.fidx >= len(rows):
            return
        label, value = rows[state.fidx]
        if strip_hidden(label) == "totp":
            code = fetch_totp(key)
            if code is None:
                # Don't fall back to the stored seed — it's not a usable
                # code, and silently copying it would paste a wrong value.
                state.status = "totp fetch failed"
                return
            value = code
        copy(value)  # raw text — collapse() is a display transform only
        state.status = f"yanked {label}"
    else:
        rows = fields.get(key) or []
        pw = next((v for label, v in rows if label == "password"), None)
        if pw:
            copy(pw)
            state.status = "yanked password"
    bump(key)


@kb.add("r", filter=nav)
def _(event):
    cur = state.selected()
    if not cur or state.focus != "fields":
        return
    rows = fields.get(cur[:2]) or []
    if state.fidx >= len(rows):
        return
    label = rows[state.fidx][0]
    rkey = (cur[0], cur[1], label)
    state.revealed ^= {rkey}


@kb.add("e", filter=nav)
async def _(event):
    cur = state.selected()
    if cur:
        await edit(cur[:2])


@kb.add("d", "d", filter=nav)
def _(event):
    """Clear the search line (vim's dd on the one editable line here)."""
    state.cursor = 0
    # .text = "" (not .reset(), which bypasses the document setter and
    # never fires on_text_changed) -> refilter() runs, re-clamps cursor.
    state.search_buffer.text = ""
    state.status = ""


@kb.add("D", "D", filter=nav)
def _(event):
    """Arm entry deletion. Deliberately not dd — that clears the search."""
    cur = state.selected()
    if not cur:
        return
    state.pending_delete = cur[:2]
    state.status = f"delete '{display_name(cur[0]).strip()}'? press Y to confirm"


@kb.add("Y", filter=nav)
def _(event):
    cur = state.selected()
    if not cur or state.pending_delete != cur[:2]:
        return
    key = cur[:2]
    r = remove(key)
    if r.returncode == 0:
        state.entries = [e for e in state.entries if e[:2] != key]
        fields.invalidate(key)
        ID_MAP.pop(key, None)
        state.refilter()
        state.status = f"deleted {display_name(cur[0]).strip()}"
    else:
        state.status = f"delete failed: {r.stderr.strip()[:50]}"
    state.pending_delete = None


@kb.add("s", filter=nav)
def _(event):
    _clear_pending()
    if not sync():
        return  # sync() already set state.status to the failure
    try:
        refresh_after_write()
    except BwError as exc:
        state.status = f"sync: re-list failed: {exc}"
        return
    if state.status.startswith("refresh cancelled"):
        return  # refresh_after_write() already set its own status
    state.status = "synced"


@kb.add("/", filter=nav)
def _(event):
    """Search within the open entry's fields.

    The list is already filtered by plain typing, so `/` addresses the
    detail pane instead — jump to the next field whose label or value
    matches. Focuses the field pane if not already there.
    """
    cur = state.selected()
    if not cur:
        return
    state.focus = "fields"
    state.input_target = "field_search"
    state.field_query = ""
    event.app.vi_state.input_mode = InputMode.INSERT


@kb.add("c-u", filter=ins_field)
def _(event):
    # field_search only — it's a plain string, not a Buffer. ins_field
    # excludes target=="search" so this can't shadow the Buffer's own vi
    # binding (unix-line-discard), which already handles ctrl-u natively
    # for the real search Buffer — no code needed here for that case.
    state.field_query = ""


# ── Keychain-save consent — one-shot status-line prompt, not a GUI dialog ──
# Gated by `awaiting_consent` instead of `nav` so these keys fully pre-empt
# their normal bindings (y=yank, n/N=nothing normally, esc=leave-search)
# for exactly the one interaction where this question is live. Default is
# No: enter, esc, n/N, or anything else all decline; only 'y' saves.

@kb.add("y", filter=awaiting_consent)
def _(event):
    _resolve_keychain_consent(event.app, save=True)


@kb.add("n", filter=awaiting_consent)
@kb.add("N", filter=awaiting_consent)
def _(event):
    """Explicit decline — remembered, never asked again."""
    _resolve_keychain_consent(event.app, save=False)


@kb.add("escape", filter=awaiting_consent)
@kb.add("enter", filter=awaiting_consent)
def _(event):
    """Dismiss WITHOUT remembering: ask again next launch.

    Only y and n/N are answers. A stray keystroke must never write a
    permanent decline — that is how a spurious marker appeared once.
    """
    _resolve_keychain_consent(event.app, save=False, remember=False)


@kb.add("<any>", filter=awaiting_consent)
def _(event):
    """Swallow everything else so the modal stays up until answered."""
    return


@kb.add("?", filter=nav)
def _(event):
    state.help = not state.help


def _launch_popup_hide():
    """Detached, non-blocking `vault-popup` — it sees this window on the
    current space and stashes it (yabai move to STASH). Same BIN-relative
    lookup as vault-frecency. Returns True if the launch itself succeeded
    (not whether the stash happened — that's yabai's job, async)."""
    try:
        subprocess.Popen([os.path.join(BIN, "vault-popup")],
                          start_new_session=True)
        return True
    except OSError:
        return False


@kb.add("q", filter=nav)
def _on_q(event):
    if os.environ.get("VAULT_TUI_POPUP") and _launch_popup_hide():
        return
    event.app.exit()
    os._exit(0)


@kb.add("Q", filter=nav)
def _(event):
    event.app.exit()
    os._exit(0)


@kb.add("escape", filter=ins)
@kb.add("enter", filter=ins)
def _(event):
    # Leaving the search line must NOT clear the query (issue #10) — only
    # field_search's transient jump-query gets wiped. The search Buffer's
    # own text is untouched; refocus the list so vi motions go back to nav.
    event.app.vi_state.input_mode = InputMode.NAVIGATION
    state.input_target = "search"
    state.field_query = ""
    if state.focus == "list":
        event.app.layout.focus(list_window)


@kb.add("backspace", filter=ins_field)
def _(event):
    # field_search only — the search Buffer handles its own backspace via
    # prompt_toolkit's default vi bindings when focused (ins_field excludes
    # it, so this binding doesn't even match and can't steal the keypress).
    state.field_query = state.field_query[:-1]
    _jump_to_field()


@kb.add("<any>", filter=ins_field)
def _(event):
    # field_search only — the search Buffer handles its own typing (and
    # dw/cw/paste/undo/...) via prompt_toolkit's default vi bindings when
    # focused; on_text_changed drives refilter() for it. ins_field excludes
    # target=="search" so this can't shadow the Buffer's own <any> handler.
    ch = event.data
    if not ch or not ch.isprintable():
        return
    state.field_query += ch
    _jump_to_field()


def _jump_to_field():
    """Move fidx to the first field matching field_query. No wrap, no-op on miss."""
    cur = state.selected()
    if not cur or not state.field_query:
        return
    q = state.field_query.lower()
    for i, (label, value) in enumerate(fields.get(cur[:2]) or []):
        if q in label.lower() or q in str(value).lower():
            state.fidx = i
            return


# ── 7. main ──────────────────────────────────────────────────────────────────

def _remove_stale_plaintext_cache():
    """One-time cleanup: a pre-in-process-decrypt version of this tool wrote
    every field, in plaintext, to $TMPDIR/bwvault-fields.json. That file is
    now pointless (nothing reads or writes it) and holds live secrets on
    disk, so remove it on startup if a previous run left one behind."""
    try:
        os.remove(FIELDS_JSON)
    except FileNotFoundError:
        pass
    except OSError:
        pass  # best-effort; a leftover file is a warning, not fatal


_pending_consent = {"email": None, "pw": None}   # cleared the instant it resolves


def _offer_keychain_save(email, pw, status_suffix=""):
    """Arm the one-shot status-line consent prompt (see the `awaiting_consent`
    key bindings). The password is held in _pending_consent only until the
    user answers — y/n/enter/esc/anything all resolve it immediately.
    """
    _pending_consent["email"] = email
    _pending_consent["pw"] = pw
    state.awaiting_keychain_consent = True
    state.status = ("Save master password to Keychain so this stops asking?"
                    f"  y / N{status_suffix}")


def _resolve_keychain_consent(app, save, remember=True):
    email = _pending_consent["email"]
    pw = _pending_consent["pw"]
    _pending_consent["email"] = None
    _pending_consent["pw"] = None          # discarded now, either way
    state.awaiting_keychain_consent = False
    if save and email and pw:
        try:
            keychain_set(email, pw)
            state.status = "saved to Keychain — won't ask again on launch"
        except Exception as exc:
            state.status = f"Keychain save failed: {exc} — will ask again next launch"
    elif remember:
        record_keychain_decline()
        state.status = "not saved — won't ask again"
    else:
        state.status = "dismissed — will ask again next launch"
    pw = None


def _patch_after_write(old_key, item_id, item):
    """Update fields/ID_MAP/state.entries for ONE just-written item, without
    a re-list round trip.

    GET /list/object/items on `bw serve` does NOT reflect a PUT until the
    next /sync (verified live: the single-item GET/PUT endpoints are
    immediately consistent, but the list endpoint keeps serving its own
    stale snapshot) — so refresh_after_write()'s re-list would silently
    show the pre-edit value right after a successful save. Patching the
    one item we already have the fresh JSON for (the PUT response) sidesteps
    that bug entirely, needs no extra request, and no password.
    """
    rows = _rows_from_item(item, FOLDER_MAP)
    name = item.get("name") or ""
    user = next((v for label, v in rows if label == "username"), "")
    new_key = (name, user)
    if new_key != old_key:
        fields.invalidate(old_key)
        ID_MAP.pop(old_key, None)
        # Drop both the old row and any pre-existing row at new_key (a rare
        # (name, user) collision with another item) before re-appending —
        # otherwise the list would carry a duplicate row for new_key.
        state.entries = [e for e in state.entries
                          if e[:2] != old_key and e[:2] != new_key]
        folder_name = FOLDER_MAP.get(item.get("folderId")) or ""
        state.entries.append((name, user, folder_name))
    fields.cache[new_key] = rows
    ID_MAP[new_key] = item_id
    state.refilter()
    # refilter() only clamps the cursor — it doesn't know the edit may have
    # moved this item's row (name/user changed -> row re-appended at the
    # end). Re-find it so the detail pane doesn't show a different item
    # right after "saved".
    idx = next((i for i, e in enumerate(state.rows) if e[:2] == new_key), None)
    if idx is not None:
        state.cursor = idx
        state.follow_viewport()


def refresh_after_write():
    """Re-list after s/Y so the cache reflects what bw serve now holds.

    `s` runs an explicit POST /sync first (via sync()), which is what makes
    the list endpoint's snapshot current again — see _patch_after_write()'s
    docstring for why a re-list right after an edit's PUT, with no sync in
    between, would show stale data instead.

    Re-unlocks only if the vault turns out to be locked (e.g. externally,
    by vault-popup's lock-on-hide) — load_vault() -> unlock() is a no-op
    when already unlocked, so this needs no password on the common path.
    Cancelling an unlock prompt just keeps the pre-write cache (stale but
    not wrong about anything the user didn't just change locally). The
    one-time save-to-Keychain offer only ever fires from main() at
    startup, never here — mid-session isn't the place to interrupt with
    that question again.
    """
    global ID_MAP
    result = load_vault(offer_consent=False)
    if result is None:
        state.status = "refresh cancelled — fields may be stale, press s to retry"
        return
    cache, id_map, _email, _pw_for_consent = result
    ID_MAP = id_map
    fields.clear(seed=cache)
    state.entries = entries_from_cache(cache)
    state.refilter()


def build_app():
    global list_window
    style = Style.from_dict({
        "sel": "reverse",
        "cur": "bold",
        "title": "bold #89b4fa",
        "key": "#f9e2af",
        "mode": "bg:#a6e3a1 #1e1e2e bold",
        "imode": "bg:#f9e2af #1e1e2e bold",
        "dim": "#6c7086",
        "status": "#f38ba8",
        "sep": "#45475a",
        "modal": "bg:#313244 #cdd6f4",
        "modalkey": "bg:#313244 #a6e3a1 bold",
        "query": "#cdd6f4 bold",
        "searchon": "bg:#89b4fa #1e1e2e bold",
        "fieldon": "bg:#f9e2af #1e1e2e bold",
    })

    # Real vi-modal line editor for the LIST filter (issue #10). refilter()
    # hooks on_text_changed so filtering stays live regardless of HOW the
    # text changed — typed, pasted, dw/cw'd, or undone.
    state.search_buffer = Buffer(multiline=False,
                                  on_text_changed=lambda buf: state.refilter())

    def search_label_text():
        return search_label(state, _app)

    def search_count_text():
        return search_count(state)

    def search_field_text_fn():
        return search_field_text(state, _app)

    def list_text():
        return list_view(state, fields)

    def detail_text():
        if state.awaiting_keychain_consent:
            return consent_modal(_pending_consent.get("email") or "")
        if state.help:
            return help_view()
        return field_view(state, fields)

    def status_text():
        return status_view(state, _app, fields)

    in_field_search = Condition(lambda: state.input_target == "field_search")

    search_window = Window(
        BufferControl(buffer=state.search_buffer,
                      input_processors=[BeforeInput(" ")]),
        height=1)

    list_window = Window(FormattedTextControl(list_text), width=D(preferred=54))

    bar = VSplit([
        Window(FormattedTextControl(search_label_text), dont_extend_width=True),
        ConditionalContainer(search_window, filter=~in_field_search),
        ConditionalContainer(Window(FormattedTextControl(search_field_text_fn)),
                             filter=in_field_search),
        Window(FormattedTextControl(search_count_text), dont_extend_width=True,
              align=WindowAlign.RIGHT),
    ], height=1)

    layout = Layout(HSplit([
        bar,
        VSplit([
            list_window,
            Window(width=1, char="│", style="class:sep"),
            Window(FormattedTextControl(detail_text)),
        ]),
        Window(FormattedTextControl(status_text), height=1),
    ]))

    return Application(layout=layout, key_bindings=kb, style=style,
                       full_screen=True, mouse_support=False,
                       editing_mode=EditingMode.VI)


def _on_hup(_sig, _frm):
    os._exit(0)


def main():
    global state, fields, _app, ID_MAP

    if "--check" in sys.argv:
        run_self_check()
        return

    _remove_stale_plaintext_cache()

    try:
        ensure_bw_serve()
    except BwError as exc:
        print(f"vault-tui: {exc}", file=sys.stderr)
        sys.exit(1)

    # Unlock once, list everything. Every entry is already plaintext from
    # bw serve, so it's warm from here on; there is no hydration path left
    # to fall back to.
    result = load_vault(offer_consent=True)
    if result is None:
        print("vault-tui: unlock cancelled — no Keychain item and no "
              "password entered at the prompt", file=sys.stderr)
        sys.exit(1)
    cache, id_map, email, pw_for_consent = result
    ID_MAP = id_map

    entries = entries_from_cache(cache)
    fields = Fields(seed=cache)

    # state + application
    state = State(entries)
    _app = build_app()

    if pw_for_consent is not None:
        _offer_keychain_save(email, pw_for_consent)

    # vault-popup locates this window by title.
    sys.stdout.write("\033]0;bwvault\007")
    sys.stdout.flush()

    global LAST_USED
    LAST_USED = load_last_used()

    def pre_run():
        # Start in search: the picker is opened to find something, so the
        # first keystroke should filter. esc drops to NORMAL for vim keys.
        # (run() resets vi_state, so this must happen once live, not at
        # construction time.)
        _app.vi_state.input_mode = InputMode.INSERT
        state.input_target = "search"
        _app.layout.focus(state.search_buffer)

    signal.signal(signal.SIGHUP, _on_hup)
    signal.signal(signal.SIGTERM, _on_hup)

    # 6/7
    _app.run(pre_run=pre_run)


# ── self-check ───────────────────────────────────────────────────────────────

def _rows_check():
    """_rows_from_item() over sample bw item JSON — no network, no bw serve.

    Covers login (+ uris + hidden custom field + plain custom field),
    card, folder-name resolution, and notes — the row-building contract
    views depend on.
    """
    folder_map = {"folder-1": "Work"}
    login_item = {
        "id": "it-1", "type": 1, "name": "sample login", "folderId": "folder-1",
        "notes": "line1\nline2",
        "login": {"username": "alice", "password": "hunter2", "totp": "SEED123",
                  "uris": [{"uri": "https://a.example"},
                           {"uri": "https://b.example", "match": 1}]},
        "fields": [{"name": "apikey", "value": "secret-val", "type": 1},
                  {"name": "plain-field", "value": "plain-val", "type": 0}],
    }
    rows = _rows_from_item(login_item, folder_map)
    assert rows[:5] == [("username", "alice"), ("password", "hunter2"),
                        ("totp", "SEED123"), ("uri", "https://a.example"),
                        ("uri", "https://b.example")], rows
    hidden = [l for l, v in rows if is_hidden(l)]
    assert len(hidden) == 1 and strip_hidden(hidden[0]) == "apikey", rows
    assert ("plain-field", "plain-val") in rows
    assert ("folder", "Work") in rows
    assert ("notes", "line1  ⏎  line2") in rows
    print("PASS: _rows_from_item builds login rows — uris, hidden field, "
          "folder name, notes, in order")

    card_item = {"id": "it-2", "type": 3, "name": "sample card",
                 "card": {"cardholderName": "Bob Jones", "brand": "Visa",
                         "number": "4111111111111111", "code": "123",
                         "expMonth": "04", "expYear": "2030"}}
    rows2 = _rows_from_item(card_item, {})
    assert rows2 == [("cardholder name", "Bob Jones"), ("brand", "Visa"),
                     ("number", "4111111111111111"), ("code", "123"),
                     ("exp month", "04"), ("exp year", "2030")], rows2
    print("PASS: _rows_from_item builds card rows with correct labels")

    # build_cache(): (name, user) keying + id map, same contract decrypt_all()
    # used to provide.
    cache, id_map = build_cache([login_item, card_item], folder_map)
    assert cache[("sample login", "alice")][:1] == [("username", "alice")]
    assert id_map[("sample login", "alice")] == "it-1"
    assert id_map[("sample card", "")] == "it-2"
    print("PASS: build_cache() keys by (name, user) and tracks item ids")


def _bw_stub_check():
    """Locked -> unlock -> retry, against an in-process http.server stub —
    the only network this check touches. No real bw serve, no real vault."""
    import http.server
    import threading as _threading

    box = {"locked": True, "unlock_calls": 0}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, obj, code=200):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/status":
                self._send({"success": True, "data": {"template": {
                    "status": "locked" if box["locked"] else "unlocked",
                    "userEmail": "stub@example.com"}}})
            elif self.path == "/list/object/items":
                if box["locked"]:
                    self._send({"success": False, "message": "Vault is locked."})
                else:
                    self._send({"success": True, "data": {"data": []}})
            else:
                self._send({"success": False, "message": "not found"}, 404)

        def do_POST(self):
            if self.path != "/unlock":
                self._send({"success": False, "message": "not found"}, 404)
                return
            length = int(self.headers.get("Content-Length", 0))
            body = json.loads(self.rfile.read(length) or b"{}")
            box["unlock_calls"] += 1
            if body.get("password") == "right-pw":
                box["locked"] = False
                self._send({"success": True, "data": {}})
            else:
                self._send({"success": False, "message": "Invalid master password."})

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    th = _threading.Thread(target=server.serve_forever, daemon=True)
    th.start()

    global BW_BASE
    real_base = BW_BASE
    real_get_pw = globals()["get_master_password"]
    try:
        BW_BASE = f"http://127.0.0.1:{port}"
        globals()["get_master_password"] = \
            lambda email, pinentry_path=None, keychain_get_fn=None: ("right-pw", False)
        r = call("GET", "/list/object/items")
        assert r.get("success") is True, r
        assert box["unlock_calls"] == 1, box
        assert not box["locked"]
        print("PASS: locked -> unlock -> retry against in-process http.server stub")
    finally:
        BW_BASE = real_base
        globals()["get_master_password"] = real_get_pw
        server.shutdown()
        th.join(timeout=2)
        server.server_close()


def _write_fake_pinentry(script_body):
    """A tiny executable python script speaking just enough Assuan to test
    prompt_password() — no GUI, no real pinentry-mac binary involved."""
    path = tempfile.mktemp(suffix="_fake_pinentry.py")
    with open(path, "w") as fh:
        fh.write(f"#!{sys.executable}\n" + script_body)
    os.chmod(path, 0o700)
    return path


def _pinentry_check():
    """Assuan protocol parsing against a FAKE pinentry — no GUI, no real binary."""
    ok_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    line = line.strip()\n"
        "    if line.startswith('GETPIN'):\n"
        "        print('D fake-password-123'); print('OK')\n"
        "    elif line.startswith('BYE'):\n"
        "        print('OK'); sys.stdout.flush(); break\n"
        "    else:\n"
        "        print('OK')\n"
        "    sys.stdout.flush()\n"
    )
    path = _write_fake_pinentry(ok_script)
    try:
        pin = prompt_password(path, desc="vault-tui --check", prompt="PIN:")
        assert pin == "fake-password-123", f"got {pin!r}"
        print("PASS: pinentry Assuan protocol parses SETDESC/SETPROMPT/GETPIN/BYE")
    finally:
        os.unlink(path)

    cancel_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    if line.strip().startswith('GETPIN'):\n"
        "        print('ERR 83886179 Operation cancelled'); sys.stdout.flush(); break\n"
        "    print('OK'); sys.stdout.flush()\n"
    )
    path2 = _write_fake_pinentry(cancel_script)
    try:
        cancelled = False
        try:
            prompt_password(path2, desc="x", prompt="x")
        except PinentryCancelled:
            cancelled = True
        assert cancelled, "ERR from pinentry should raise PinentryCancelled"
        print("PASS: pinentry cancel (ERR) raises PinentryCancelled cleanly")
    finally:
        os.unlink(path2)


def _keychain_check():
    """Keychain-first / pinentry-fallback / consent-marker logic, entirely
    against IN-PROCESS FAKES. No subprocess, no `security` binary call, no
    real Keychain access, no GUI dialog — get_master_password()'s
    keychain_get_fn parameter and keychain_set() are both plain Python
    callables here, never exec'd.
    """
    calls = []

    def fake_hit(email):
        calls.append(("get", email))
        return "keychain-password-xyz"

    def fake_pinentry_should_not_run(*a, **kw):
        raise AssertionError("pinentry must not run when the Keychain hits")

    pw, from_keychain = get_master_password(
        "user@example.com", pinentry_path="unused", keychain_get_fn=fake_hit)
    assert pw == "keychain-password-xyz" and from_keychain is True
    assert calls == [("get", "user@example.com")]
    print("PASS: keychain hit derives keys without invoking pinentry")

    def fake_miss(email):
        calls.append(("get", email))
        return None

    ok_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    line = line.strip()\n"
        "    if line.startswith('SETDESC'):\n"
        "        sys.stderr.write(line + chr(10))\n"
        "    if line.startswith('GETPIN'):\n"
        "        print('D fallback-password'); print('OK')\n"
        "    elif line.startswith('BYE'):\n"
        "        print('OK'); sys.stdout.flush(); break\n"
        "    else:\n"
        "        print('OK')\n"
        "    sys.stdout.flush()\n"
    )
    path = _write_fake_pinentry(ok_script)
    try:
        calls.clear()
        pw2, from_keychain2 = get_master_password(
            "someone@pm.me", pinentry_path=path, keychain_get_fn=fake_miss)
        assert pw2 == "fallback-password" and from_keychain2 is False
        assert calls == [("get", "someone@pm.me")]
        print("PASS: keychain miss falls through to pinentry")

        # SETDESC must name the account (stderr-echoed by the fake above).
        r = subprocess.run([path], input="SETDESC Unlock vault for someone@pm.me\nBYE\n",
                           capture_output=True, text=True, timeout=5)
        assert "someone@pm.me" in r.stderr
        print("PASS: SETDESC text contains the configured email")
    finally:
        os.unlink(path)

    # both paths failing -> PinentryCancelled, not a raw traceback
    cancel_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    if line.strip().startswith('GETPIN'):\n"
        "        print('ERR 83886179 cancelled'); sys.stdout.flush(); break\n"
        "    print('OK'); sys.stdout.flush()\n"
    )
    path3 = _write_fake_pinentry(cancel_script)
    try:
        cancelled = False
        try:
            get_master_password("nobody@pm.me", pinentry_path=path3,
                                   keychain_get_fn=fake_miss)
        except PinentryCancelled:
            cancelled = True
        assert cancelled, "keychain miss + pinentry cancel must raise cleanly"
        print("PASS: both unlock paths failing -> clean PinentryCancelled, no traceback")
    finally:
        os.unlink(path3)

    # keychain_set: consent "y" calls it with the right service/account (via
    # _resolve_keychain_consent's contract) — checked directly on the
    # function's own argument-passing, no real `security` invocation.
    set_calls = []

    def fake_set_ok(email, password, service="vault-tui"):
        set_calls.append((service, email, password))

    fake_set_ok("consent@pm.me", "the-password")
    assert set_calls == [("vault-tui", "consent@pm.me", "the-password")]
    print("PASS: keychain_set call shape matches (service, email, password)")

    def fake_set_raises(email, password, service="vault-tui"):
        raise RuntimeError("security: item already exists, denied")

    raised = False
    try:
        fake_set_raises("x@pm.me", "pw")
    except RuntimeError:
        raised = True
    assert raised, "a failing keychain_set must be catchable, not silently swallowed"
    print("PASS: keychain_set failure is a catchable exception, not a crash")

    # has_declined_keychain() / record_keychain_decline(): marker file in a
    # throwaway HOME so this never touches the real
    # ~/.local/share/vault-tui/no-keychain.
    import tempfile as _tempfile
    global NO_KEYCHAIN_MARKER
    real_marker = NO_KEYCHAIN_MARKER
    tmp_home = _tempfile.mkdtemp()
    try:
        NO_KEYCHAIN_MARKER = os.path.join(tmp_home, "no-keychain")
        assert has_declined_keychain() is False
        record_keychain_decline()
        assert has_declined_keychain() is True
        print("PASS: decline marker persists has_declined_keychain() -> True")
    finally:
        NO_KEYCHAIN_MARKER = real_marker


def _q_check():
    """q hides (calls the popup launcher, does not exit) when
    VAULT_TUI_POPUP is set and the launch succeeds; quits otherwise —
    exactly like Q always does."""
    class _FakeApp:
        def __init__(self):
            self.exited = False
        def exit(self):
            self.exited = True

    class _FakeEvent:
        def __init__(self):
            self.app = _FakeApp()

    real_launch = _launch_popup_hide
    real_exit = os._exit
    launched = []
    os._exit = lambda code: launched.append(("exit", code))  # never really exit
    try:
        globals()["_launch_popup_hide"] = lambda: launched.append("popup") or True
        ev = _FakeEvent()
        os.environ["VAULT_TUI_POPUP"] = "1"
        _on_q(ev)
        assert launched == ["popup"], launched
        assert not ev.app.exited, "q must not exit when popup hide succeeds"
        print("PASS: q hides via popup launcher when VAULT_TUI_POPUP is set")

        launched.clear()
        globals()["_launch_popup_hide"] = lambda: launched.append("popup") or False
        ev2 = _FakeEvent()
        _on_q(ev2)
        assert ev2.app.exited and launched[-1:] == [("exit", 0)], launched
        print("PASS: q falls back to quit when the popup launch fails")

        launched.clear()
        del os.environ["VAULT_TUI_POPUP"]
        ev3 = _FakeEvent()
        _on_q(ev3)
        assert ev3.app.exited and launched == [("exit", 0)]
        print("PASS: q quits outright outside popup mode")
    finally:
        globals()["_launch_popup_hide"] = real_launch
        os._exit = real_exit
        os.environ.pop("VAULT_TUI_POPUP", None)


def run_self_check():
    _rows_check()
    _bw_stub_check()
    _pinentry_check()
    _keychain_check()

    # -- Fields: plain warm-cache wrapper, no worker -------------------------
    seed = {
        (" leading", "u"): [("password", "p")],
        ("has\ttab", ""): [("username", "x")],
        ("note-entry", ""): [("notes", "line1\nline2\nline3")],
    }
    f = Fields(seed=seed)
    assert f.get((" leading", "u")) == [("password", "p")]
    assert f.get(("has\ttab", "")) == [("username", "x")]
    assert f.wait(("note-entry", ""))[0][1] == "line1\nline2\nline3"
    assert f.get(("missing", "")) is None
    f.invalidate((" leading", "u"))
    assert f.get((" leading", "u")) is None
    f.clear(seed={("re-seeded", ""): [("x", "1")]})
    assert f.get(("re-seeded", "")) == [("x", "1")]
    assert f.get((" leading", "u")) is None, "clear() replaces the whole cache"
    print("PASS: Fields is a plain synchronous warm-cache wrapper")

    # -- search Buffer: real vi-modal line editor (issue #10) --------------
    # State.search_buffer is a live prompt_toolkit Buffer; refilter() is
    # wired to its on_text_changed, so ANY edit path (typed, pasted, vi
    # motion/operator, undo) keeps the list filter live without a special
    # case per input method. Verified via direct Buffer/State calls, not
    # pty screen-scraping (misled 3x earlier today).
    entries_fixture = [("github", "u1", ""), ("gitlab", "u2", ""),
                        ("aws-console", "u3", "")]
    check_state = State(list(entries_fixture))
    check_state.search_buffer = Buffer(
        multiline=False, on_text_changed=lambda buf: check_state.refilter())

    # 1. typing into the buffer filters the list (text change -> rows shrink)
    assert len(check_state.rows) == 3
    check_state.search_buffer.insert_text("git")
    assert check_state.query == "git"
    assert len(check_state.rows) == 2, check_state.rows
    assert all("git" in r[0] for r in check_state.rows)
    print("PASS: typing into search Buffer filters the list live")

    # 2. mid-string edit: "gthub" -> cursor to index 1 -> insert "i" -> "github"
    check_state.search_buffer.text = ""
    check_state.search_buffer.insert_text("gthub")
    check_state.search_buffer.cursor_position = 1
    check_state.search_buffer.insert_text("i")
    assert check_state.query == "github", check_state.query
    assert len(check_state.rows) == 1 and check_state.rows[0][0] == "github"
    print("PASS: mid-string edit ('gthub' -> insert at idx1 -> 'github') refilters")

    # 3. dw-style deletion via REAL vi key bindings (not a hand substitute)
    # dispatches through prompt_toolkit's own Application + vi bindings
    # against a focused Buffer, exactly as build_app() wires the live UI.
    async def _check_dw():
        from prompt_toolkit.input.defaults import create_pipe_input
        from prompt_toolkit.output import DummyOutput

        dw_state = State(list(entries_fixture))
        buf = Buffer(multiline=False,
                     on_text_changed=lambda b: dw_state.refilter())
        dw_state.search_buffer = buf
        buf.insert_text("git hub")
        buf.cursor_position = 0

        win = Window(BufferControl(buffer=buf))
        app = Application(layout=Layout(win), editing_mode=EditingMode.VI,
                          full_screen=False)
        with create_pipe_input() as pipe_input:
            app.input = pipe_input
            app.output = DummyOutput()

            def pre_run():
                app.vi_state.input_mode = InputMode.NAVIGATION
                app.layout.focus(buf)

            task = asyncio.ensure_future(app.run_async(pre_run=pre_run))
            await asyncio.sleep(0.05)
            pipe_input.send_text("dw")   # vi: delete "git " -> "hub"
            await asyncio.sleep(0.05)
            app.exit()
            await asyncio.sleep(0.02)
            try:
                await task
            except BaseException:
                pass
        return dw_state, buf

    # Running a real Application prints inline-render escapes to the real
    # terminal even with app.output = DummyOutput() (rendering happens on
    # the raw fd, not through the Output abstraction, for this pt version);
    # swallow it so --check output stays legible. Assertions below are the
    # actual evidence, not this cosmetic capture.
    import asyncio
    import contextlib
    import io
    with contextlib.redirect_stdout(io.StringIO()), \
            contextlib.redirect_stderr(io.StringIO()):
        dw_state, dw_buf = asyncio.run(_check_dw())
    assert dw_buf.text == "hub", f"dw should leave 'hub', got {dw_buf.text!r}"
    assert dw_state.query == "hub"
    assert len(dw_state.rows) == 1 and dw_state.rows[0][0] == "github"
    print("PASS: dw via real vi bindings deletes word and refilters live")

    # 4. clearing the buffer restores all rows
    check_state.search_buffer.text = ""
    assert check_state.query == ""
    assert len(check_state.rows) == len(entries_fixture)
    print("PASS: clearing search Buffer restores all rows")

    # -- viewport / scroll (issue #11) --------------------------------------
    # Real headless Application via build_app() itself, so key dispatch goes
    # through the actual `kb` bindings and list_height() reads a real
    # DummyOutput size (40 rows -> list_height() == 38), not a guess.
    global state, fields, _app

    def _viewport_check():
        from prompt_toolkit.input.defaults import create_pipe_input
        from prompt_toolkit.output import DummyOutput

        big_entries = [(f"entry-{i:04d}", "u", "") for i in range(1223)]

        async def _run(keys, before=None):
            global state, fields, _app
            state = State(list(big_entries))
            fields = Fields(seed={})
            _app = build_app()
            if before:
                before()
            with create_pipe_input() as pipe_input:
                _app.input = pipe_input
                _app.output = DummyOutput()

                def pre_run():
                    _app.vi_state.input_mode = InputMode.NAVIGATION
                    _app.layout.focus(list_window)

                task = asyncio.ensure_future(_app.run_async(pre_run=pre_run))
                await asyncio.sleep(0.05)
                pipe_input.send_text(keys)
                await asyncio.sleep(0.05)
                _app.exit()
                await asyncio.sleep(0.02)
                try:
                    await task
                except BaseException:
                    pass

        with contextlib.redirect_stdout(io.StringIO()), \
                contextlib.redirect_stderr(io.StringIO()):
            asyncio.run(_run(""))
            h = list_height()
            assert h == 38, f"expected list_height()==38 for 40-row DummyOutput, got {h}"

            # list_view() returns at most `height` rows, not all 1223
            rendered = list_view(state, fields)
            assert len(rendered) <= h, \
                f"list_view() returned {len(rendered)} rows, expected <= {h}"
            assert len(rendered) < len(big_entries)

            # G -> viewport contains the last row, cursor visible within it
            asyncio.run(_run("G"))
            last = len(state.rows) - 1
            assert state.cursor == last
            assert state.top <= state.cursor < state.top + h, \
                f"cursor {state.cursor} not within viewport [{state.top}, {state.top + h})"
            assert state.top + h - 1 == last, \
                "G should pin the bottom of the viewport to the last row"

            # ctrl-d moves cursor ~half a page and the viewport follows
            asyncio.run(_run("\x04"))   # ctrl-d, cursor starts at 0
            half = h // 2
            assert state.cursor == half, f"ctrl-d: expected cursor {half}, got {state.cursor}"
            assert state.top <= state.cursor < state.top + h

            # zz centers the cursor line in the viewport
            def _seek_mid():
                state.cursor = 500
            asyncio.run(_run("zz", before=_seek_mid))
            assert state.top == max(0, 500 - h // 2), \
                f"zz: expected top {500 - h // 2}, got {state.top}"
            assert state.top <= 500 < state.top + h

            # scrolloff: moving to within 3 rows of the TOP edge scrolls the
            # view rather than pinning (mid-list, so there's room on both
            # sides — unlike the data-boundary case at row 0 or `last`).
            top_before_holder = {}

            def _seek_scrolloff_edge():
                state.cursor = 500
                state.follow_viewport()          # settle top, room on both sides
                state.cursor = state.top + SCROLLOFF   # exactly at the top margin
                top_before_holder["top"] = state.top
            asyncio.run(_run("k", before=_seek_scrolloff_edge))
            top_before = top_before_holder["top"]
            assert state.cursor == top_before + SCROLLOFF - 1
            assert state.top == top_before - 1, \
                (f"cursor at scrolloff margin: k should scroll top by 1 "
                 f"(expected {top_before - 1}, got {state.top})")

            # refilter() with a query shrinking rows below the viewport clamps
            # both cursor AND viewport
            def _seek_and_query():
                state.cursor = 900
                state.follow_viewport()
                state.search_buffer.text = "entry-0001"  # 1 match after prefix collapse -> few matches
            asyncio.run(_run("", before=_seek_and_query))
            assert len(state.rows) < h, "fixture query expected to shrink below viewport height"
            assert state.cursor == len(state.rows) - 1
            assert state.top == 0, f"top should clamp to 0 for a short list, got {state.top}"

        print("PASS: list_height()==38 for headless 40-row DummyOutput")
        print(f"PASS: list_view() returns <= height rows ({len(rendered)} <= {h}, "
              f"was 1223 pre-viewport)")
        print("PASS: G scrolls viewport to show the last row, cursor visible")
        print("PASS: ctrl-d moves cursor ~half page, viewport follows")
        print("PASS: zz centers the cursor line in the viewport")
        print("PASS: scrolloff holds — cursor near edge scrolls, viewport not pinned")
        print("PASS: refilter() clamps both cursor and viewport when rows shrink")

    _viewport_check()

    # -- q: hide popup vs quit --------------------------------------------
    # Real windows/subprocess are off-limits here (no yabai, no Ghostty), so
    # _launch_popup_hide is monkeypatched — it's the one seam the `q`
    # binding calls through. os._exit is also patched: the real one would
    # kill this test process before the assertion below ever ran.
    _q_check()

    print("ALL CHECKS PASSED")


if __name__ == "__main__":
    main()
