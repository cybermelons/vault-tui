#!/usr/bin/env python3
"""Modal vault browser built on prompt_toolkit's real vi mode.

  j/k 3j gg G      move            y yank        e edit
  /  search        dd Y delete     r reveal      s resync
  q close  Q quit  ?  help

In-process decryption (vault_crypto.py): one pinentry prompt at startup,
then decrypt_all() reads rbw's own cache db directly (PBKDF2 ~70-100ms
once, then ~8ms for the whole vault). Every entry is warm from the first
frame — no hydration worker, no per-field rbw subprocess, no plaintext
disk cache. Writes (edit/delete/sync) still go through the rbw CLI; each
re-runs decrypt_all() to refresh.
"""
import json
import os
import signal
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import vault_crypto as vc

from prompt_toolkit.application import Application, run_in_terminal
from prompt_toolkit.buffer import Buffer
from prompt_toolkit.enums import EditingMode
from prompt_toolkit.filters import Condition
from prompt_toolkit.key_binding import KeyBindings
from prompt_toolkit.key_binding.vi_state import InputMode
from prompt_toolkit.layout import HSplit, Layout, VSplit, Window
from prompt_toolkit.layout.containers import ConditionalContainer, WindowAlign
from prompt_toolkit.layout.controls import BufferControl, FormattedTextControl
from prompt_toolkit.layout.dimension import D
from prompt_toolkit.layout.processors import BeforeInput
from prompt_toolkit.styles import Style

HOME = os.path.expanduser("~")
BIN = os.path.join(HOME, ".local/bin")
CACHE = "/tmp/bwvault-cache"
# Plaintext field cache — retired by in-process decryption. Only referenced
# now to delete a stale one left by a previous version (never written again).
FIELDS_JSON = os.path.join(tempfile.gettempdir(), "bwvault-fields.json")
MASK = ("password", "code", "ssn", "number", "totp")


# ── 1. rbw shell — pure, no UI imports ──────────────────────────────────────

def run(argv, timeout=None, **kw):
    return subprocess.run(argv, capture_output=True, text=True,
                           timeout=timeout, **kw)


def load_entries():
    """(name, user, folder) rows: cache (fallback rbw list), then ranked."""
    try:
        raw = open(CACHE).read()
    except OSError:
        raw = run(["rbw", "list", "--fields", "name,user,folder"]).stdout
    ranked = run([os.path.join(BIN, "vault-frecency"), "rank"], input=raw)
    lines = (ranked.stdout or raw).splitlines()
    out = []
    for line in lines:
        p = line.split("\t")
        if p and p[0].strip():
            out.append((p[0], p[1] if len(p) > 1 else "",
                        p[2] if len(p) > 2 else ""))
    return out


def unlock_and_decrypt():
    """Keychain first, pinentry fallback; decrypt the whole vault.

    No prompt on a normal launch once the Keychain item exists (account =
    the email from rbw's config.json). A prompt appears only when that
    lookup misses, and it names the account being unlocked so it's never
    ambiguous which of several similar addresses this is for.

    The password is normally discarded the instant derive_keys() returns.
    The ONE exception: when it came from pinentry (not the Keychain) and
    the user hasn't already declined Keychain storage, it's held a moment
    longer so main() can offer the one-time "save to Keychain?" prompt —
    see _offer_keychain_save(). It is cleared the instant that resolves,
    same as every other path.

    -> (cache, skipped, email, pw_for_consent) or None if both the
    Keychain and the pinentry prompt came up empty. pw_for_consent is None
    except in that one carve-out case above.
    """
    email, pinentry = vc.load_config()
    db = vc.load_db(email)
    try:
        pw, from_keychain = vc.get_master_password(email, pinentry_path=pinentry)
    except vc.PinentryCancelled:
        return None
    sym = vc.derive_keys(pw, email, db["iterations"])
    offer_consent = (not from_keychain) and not vc.has_declined_keychain()
    pw_for_consent = pw if offer_consent else None
    pw = None  # discarded now unless held above for the consent prompt
    priv = vc.account_private_key(db.get("protected_private_key"), *sym)
    org_keys = vc.org_sym_keys(db.get("protected_org_keys"), priv)
    cache, skipped = vc.decrypt_all(db, sym, org_keys)
    return cache, skipped, email, pw_for_consent


UNNAMED = "(unnamed)"


def display_name(name):
    """Render an entry's real (possibly empty) name for the UI.

    A CipherString can genuinely decrypt to an empty string — that's a
    valid entry, not a decrypt failure (rbw's own `list` command once
    discarded 1223 entries by mistaking exactly this for one). Never strip
    the real name for lookups; this is a display-only substitution.
    """
    return name if name.strip() else UNNAMED


def entries_from_cache(cache):
    """decrypt_all()'s cache -> frecency-ranked (name, user, folder) rows.

    Replaces the rbw-list-driven load_entries() as the primary source: the
    decrypted cache is free (already computed) and always current, unlike
    the separate /tmp/bwvault-cache list which can go stale until a resync
    reruns. folder isn't tracked per-key here (decrypt_all's cache doesn't
    carry it), so it's left blank — unused by ranking or the list view
    beyond the search-filter string.

    Every key in `cache` came from decrypt_all(), which already only fails
    an entry on a real MAC mismatch — so nothing here is re-filtered by
    name content. An empty/whitespace name is fed through vault-frecency
    AS ITSELF (the real cache key, never rewritten), and only display_name()
    substitutes UNNAMED for showing it — state.selected()[:2] must keep
    matching the actual (name, user) key fields.get() looks up.
    """
    lines = "\n".join(f"{name}\t{user}\t" for name, user in cache)
    ranked = run([os.path.join(BIN, "vault-frecency"), "rank"], input=lines)
    seen = set(cache.keys())
    out = []
    for line in (ranked.stdout or lines).splitlines():
        p = line.split("\t")
        if len(p) < 2:
            continue
        name, user = p[0], p[1]
        if (name, user) not in seen:
            continue    # a genuinely blank ranker line, not a real entry
        seen.discard((name, user))
        out.append((name, user, p[2] if len(p) > 2 else ""))
    # Anything vault-frecency's ranker dropped (e.g. it also filters blank
    # names) still gets a row — real entries are never silently discarded.
    for name, user in seen:
        out.append((name, user, ""))
    return out


def bump(key):
    subprocess.Popen([os.path.join(BIN, "vault-frecency"), "bump", *key],
                      start_new_session=True)


def sync():
    run(["rbw", "sync"])


def remove(key):
    name, user = key
    args = ["rbw", "remove", name] + ([user] if user else [])
    return run(args)


def edit(key):
    name, user = key
    args = ["rbw", "edit", name] + ([user] if user else [])
    env = dict(os.environ)
    env.setdefault("EDITOR", "nvim")
    run_in_terminal(lambda: subprocess.run(args, env=env))


# ── 2. Fields — wholesale warm cache, no worker ─────────────────────────────
#
# decrypt_all() at startup populates .cache for every entry in one shot
# (~8ms for 1218 entries). No hydration cursor, no cold/fetching markers,
# no background thread: every entry is warm from the first frame. The class
# shape (.get/.wait/.invalidate/.clear/.active_key/.last_error/
# .hydrate_paused) is kept because the render/key-binding call sites read
# it — but .wait() and .get() are now the same synchronous dict lookup, and
# .active_key/.hydrate_paused are permanently inert (kept so list_view()'s
# "cold/fetching" marker logic, unchanged below, still has something to read).


class Fields:
    def __init__(self, seed=None):
        self.cache = dict(seed or {})
        self.active_key = None     # never set: nothing fetches asynchronously
        self.last_error = {}       # kept for the field_view() error-row path
        self.hydrate_paused = False

    def get(self, key):
        return self.cache.get(key)

    def wait(self, key, timeout=10):
        return self.cache.get(key)

    def invalidate(self, key):
        self.cache.pop(key, None)

    def clear(self, seed=None):
        self.cache = dict(seed or {})


# ── 3. clipboard ─────────────────────────────────────────────────────────────

def copy(text):
    subprocess.run(["pbcopy"], input=text, text=True)

    def clear_if_unchanged():
        try:
            cur = run(["pbpaste"]).stdout
        except Exception:
            return
        if cur == text:
            subprocess.run(["pbcopy"], input="", text=True)

    t = threading.Timer(30, clear_if_unchanged)
    t.daemon = True
    t.start()


# ── 4. state ─────────────────────────────────────────────────────────────────

SCROLLOFF = 3


class State:
    def __init__(self, entries):
        self.entries = entries
        self.rows = []
        self.cursor = 0
        self.top = 0               # first visible row index (viewport)
        self.focus = "list"       # "list" | "fields"
        self.fidx = 0
        self.revealed = set()     # {(name, user, label)}
        self.pending_delete = None
        self.status = ""
        self.help = False
        # search_buffer is the query's real store (a prompt_toolkit Buffer in
        # vi mode, wired in build_app()); this starts empty and stays in sync
        # via on_text_changed -> refilter(), so `query` always reads live.
        self.search_buffer = None
        self.input_target = "search"   # where INSERT keystrokes land
        self.field_query = ""          # `/` search inside the open entry
        self.awaiting_keychain_consent = False   # y/N status-line prompt
        self.refilter()            # rows is assigned only here

    @property
    def query(self):
        return self.search_buffer.text if self.search_buffer else ""

    def refilter(self):
        """The ONLY place `rows` is assigned. Clamps cursor, resets fidx."""
        if not self.query:
            self.rows = self.entries
        else:
            q = self.query.lower()
            self.rows = [e for e in self.entries
                         if q in (e[0] + " " + e[1] + " " + e[2]).lower()]
        self.cursor = min(self.cursor, max(0, len(self.rows) - 1))
        self.fidx = 0
        self.pending_delete = None
        self.top = min(self.top, max(0, len(self.rows) - 1))
        self.follow_viewport()

    def follow_viewport(self, height=None):
        """Keep cursor visible with SCROLLOFF margin. Clamps `top`."""
        n = len(self.rows)
        h = height if height is not None else list_height()
        if h <= 0 or n <= h:
            self.top = 0
            return
        lo = self.cursor - h + 1 + SCROLLOFF
        hi = self.cursor - SCROLLOFF
        if self.top < lo:
            self.top = lo
        if self.top > hi:
            self.top = hi
        self.top = max(0, min(self.top, n - h))

    def selected(self):
        if self.rows and self.cursor < len(self.rows):
            return self.rows[self.cursor]
        return None


# ── 5. views — pure over (state, cache); display transforms live here ──────

def masked(label, value, revealed_key, revealed):
    if any(m in label.lower() for m in MASK) and revealed_key not in revealed:
        return "•" * 8
    return value


def collapse(value):
    return value.replace("\n", "⏎")


LAST_USED = {}          # (name, user) -> epoch seconds of most recent use


def load_last_used():
    """Most-recent-use timestamp per entry, from the frecency store.

    Same file vault-frecency writes; keys are tab-joined there. Missing or
    corrupt is not fatal — the column just renders blank.
    """
    path = os.path.expanduser("~/.local/share/vault-frecency.json")
    try:
        with open(path) as fh:
            raw = json.load(fh)
    except Exception:
        return {}
    out = {}
    for joined, stamps in raw.items():
        if not stamps:
            continue
        name, _, user = joined.partition("\t")
        out[(name, user)] = max(stamps)
    return out


def ago(ts):
    """Compact relative age: 3m, 5h, 2d, 6w. Blank when never used."""
    if not ts:
        return ""
    d = time.time() - ts
    if d < 60:
        return "now"
    for span, suffix in ((3600, "m"), (86400, "h"), (604800, "d"), (None, "w")):
        if span is None:
            return f"{int(d // 604800)}w"
        if d < span:
            prev = {"m": 60, "h": 3600, "d": 86400}[suffix]
            return f"{int(d // prev)}{suffix}"
    return ""


def list_view(state, fields):
    h = list_height()
    if h > 0:
        state.follow_viewport(h)
        window = list(enumerate(state.rows))[state.top:state.top + h]
    else:
        window = list(enumerate(state.rows))
    out = []
    for i, (name, user, _folder) in window:
        style = "class:sel" if (i == state.cursor and state.focus == "list") \
            else ("class:cur" if i == state.cursor else "")
        key = (name, user)
        # No cold/fetching marker: decrypt_all() warms every entry up front,
        # so there is no async state left for a row to be "in" here.
        used = ago(LAST_USED.get(key))
        shown_name = display_name(name).strip()
        out.append((style,
                    f" {used:>4} {shown_name[:24]:<24} {user[:16]:<16}\n"))
    if not out:
        msg = "vault empty — run `rbw sync`" if not state.entries else "(no matches)"
        return [("", f"  {msg}\n")]
    return out


def field_view(state, fields):
    cur = state.selected()
    if not cur:
        return [("", "")]
    key = cur[:2]
    rows = fields.get(key) or fields.last_error.get(key)
    out = [("class:title", f" {display_name(cur[0]).strip()}\n\n")]
    if rows is None:
        out.append(("class:dim", " loading…\n"))
        return out
    if rows and rows[0][0] in ("ERROR", "error"):
        # A failed decrypt must not look like an empty entry. Say what broke
        # and what to do — "(no fields)" hid an invalid-mac failure across
        # the whole vault once.
        out.append(("class:status", f" ⚠ {rows[0][1]}\n\n"))
        out.append(("class:dim", " entry could not be read — it is NOT deleted.\n"
                                 " try:  s  to resync,  or  rbw unlock\n"))
        return out
    if not rows:
        out.append(("class:dim", " (no fields)  — entry has no readable data\n"))
        return out
    for j, (label, value) in enumerate(rows):
        rkey = (key[0], key[1], label)
        shown = collapse(masked(label, value, rkey, state.revealed))
        style = "class:sel" if (j == state.fidx and state.focus == "fields") else ""
        out.append(("class:key", f" {label:<15}"))
        out.append((style, f"{shown[:44]}\n"))
    return out


HELP = [
    ("class:title", " KEYS\n\n"),
    ("class:key", " MOVE\n"),
    ("", "  j / k          down / up   (3j = 3 down)\n"
         "  gg / G         top / bottom\n"
         "  l / enter      focus fields pane\n"
         "  h / esc        back to list\n\n"),
    ("class:key", " SCROLL\n"),
    ("", "  ctrl-d/u       half page down / up\n"
         "  ctrl-f/b       full page down / up\n"
         "  ctrl-e/y       scroll one line (cursor stays put)\n"
         "  zz / zt / zb   center / top / bottom cursor line\n"
         "  H / M / L      cursor to top / mid / bottom of view\n\n"),
    ("class:key", " SEARCH\n"),
    ("", "  /              search (insert mode)\n"
         "  esc / enter    leave search, keep filter\n"
         "  dd             clear the filter\n\n"),
    ("class:key", " ACTIONS\n"),
    ("", "  y              yank password, or selected field\n"
         "  r              reveal a masked field\n"
         "  e              edit  (password + notes only)\n"
         "  dd then Y      delete entry\n"
         "  s              force sync\n\n"),
    ("class:key", " EXIT\n"),
    ("", "  q              close (alt-p hides/shows)\n"
         "  Q              quit\n"
         "  ?              toggle this help\n"),
]


def help_view():
    return HELP


def search_label(state, app):
    """Left badge: which target is active. SEARCH blue / IN ENTRY yellow."""
    insert = app and app.vi_state.input_mode == InputMode.INSERT
    in_field = state.input_target == "field_search"
    typing = insert and not in_field
    if in_field:
        return [("class:fieldon", " IN ENTRY ")]
    return [("class:searchon" if typing else "class:dim",
              " SEARCH " if typing else "    /    ")]


def search_field_text(state, app):
    """Right-hand side of the bar when target is field_search (plain string)."""
    insert = app and app.vi_state.input_mode == InputMode.INSERT
    caret = "\u2588" if insert else ""
    return [("class:query", f" /{state.field_query}{caret}"),
            ("class:dim", f"   {display_name(state.rows[state.cursor][0]).strip()[:28]}"
             if state.rows else "")]


def search_count(state):
    """Right badge: match count, shown next to the real search Buffer."""
    return [("class:dim", f"   {len(state.rows)}/{len(state.entries)}")]


def status_view(state, app, fields):
    mode = "INSERT" if (app and app.vi_state.input_mode == InputMode.INSERT) \
        else "NORMAL"
    left = f" {mode} "
    info = ""
    msg = state.status
    if not msg and fields.hydrate_paused:
        msg = "vault locked — unlock with rbw unlock, then press s"
    return [("class:mode" if mode == "NORMAL" else "class:imode", left),
            ("class:dim", info + "   "),
            ("class:status", msg or ""),
            ("class:dim", "" if msg else
             "? help   esc normal   y yank   dd clear search   q close")]


# ── module-level wiring (main() populates these before app.run()) ──────────

state = None
fields = None
_app = None
list_window = None      # the list pane's Window — focus target on esc/enter


def get_app():
    return _app


CHROME_ROWS = 2   # bar (1) + status (1); list pane fills the rest


def list_height():
    """Visible row count for the list pane, or 0 if not renderable yet.

    Uses the terminal size from the running Application's output, minus the
    fixed-height bar/status rows — simplest source of truth available: no
    extra Window/ScrollablePane machinery, no second layout pass. Callable
    outside a running app (e.g. --check) returns 0, which callers treat as
    "unknown, don't clip."
    """
    app = get_app()
    if app is None:
        return 0
    try:
        rows = app.output.get_size().rows
    except Exception:
        return 0
    return max(0, rows - CHROME_ROWS)


# ── 6. keys ──────────────────────────────────────────────────────────────────

kb = KeyBindings()
awaiting_consent = Condition(lambda: state is not None
                             and state.awaiting_keychain_consent)
nav = Condition(lambda: _app is not None
                and _app.vi_state.input_mode == InputMode.NAVIGATION
                and not (state is not None and state.awaiting_keychain_consent))
ins = Condition(lambda: _app is not None
                and _app.vi_state.input_mode == InputMode.INSERT)
# field_search is a plain string (not a Buffer), so its typing/backspace/esc
# still need hand-rolled handlers. These must NOT fire for input_target ==
# "search" — that target is now a real focused Buffer, and prompt_toolkit's
# own default vi bindings (registered on the Application, gated by
# buffer_has_focus) need to see those keys instead, or motions like dw/cw
# never reach it. `kb` is global — it merges with the focused control's own
# bindings regardless of layout focus — so this filter is the only gate.
ins_field = Condition(lambda: _app is not None
                      and _app.vi_state.input_mode == InputMode.INSERT
                      and state is not None
                      and state.input_target == "field_search")


def _clear_pending():
    state.pending_delete = None


@kb.add("c-j")
def _(event):
    if state.focus == "list":
        state.cursor = min(state.cursor + 1, max(0, len(state.rows) - 1))
        state.follow_viewport()
    else:
        rows = fields.get(state.selected()[:2]) if state.selected() else None
        state.fidx = min(state.fidx + 1, max(0, len(rows or []) - 1))


@kb.add("c-k")
def _(event):
    if state.focus == "list":
        state.cursor = max(state.cursor - 1, 0)
        state.follow_viewport()
    else:
        state.fidx = max(state.fidx - 1, 0)


@kb.add("j", filter=nav)
def _(event):
    _clear_pending()
    n = event.arg or 1
    if state.focus == "list":
        state.cursor = min(state.cursor + n, max(0, len(state.rows) - 1))
        state.follow_viewport()
    else:
        rows = fields.get(state.selected()[:2]) if state.selected() else None
        state.fidx = min(state.fidx + n, max(0, len(rows or []) - 1))


@kb.add("k", filter=nav)
def _(event):
    _clear_pending()
    n = event.arg or 1
    if state.focus == "list":
        state.cursor = max(state.cursor - n, 0)
        state.follow_viewport()
    else:
        state.fidx = max(state.fidx - n, 0)


@kb.add("g", "g", filter=nav)
def _(event):
    _clear_pending()
    state.cursor = 0
    state.follow_viewport()


@kb.add("G", filter=nav)
def _(event):
    _clear_pending()
    state.cursor = max(0, len(state.rows) - 1)
    state.follow_viewport()


# ── vi scroll bindings (issue #11) — all list-focused, filter=nav ──────────

def _page(n):
    """Move cursor by n rows (viewport-relative), clamp, follow."""
    state.cursor = max(0, min(state.cursor + n, max(0, len(state.rows) - 1)))
    state.follow_viewport()


@kb.add("c-d", filter=nav)
def _(event):
    _clear_pending()
    _page(max(1, list_height() // 2) or 1)


@kb.add("c-u", filter=nav)
def _(event):
    # NORMAL-mode ctrl-u: was "clear the filter" (issue #10 left this as the
    # swap point); issue #11 reassigns it to half-page-up scroll. The search
    # Buffer's own ctrl-u (unix-line-discard, prompt_toolkit native) is
    # untouched — it only fires while that Buffer has focus (INSERT mode),
    # never here.
    _clear_pending()
    _page(-(max(1, list_height() // 2) or 1))


@kb.add("c-f", filter=nav)
def _(event):
    _clear_pending()
    _page(max(1, list_height()) or 1)


@kb.add("c-b", filter=nav)
def _(event):
    _clear_pending()
    _page(-(max(1, list_height()) or 1))


@kb.add("c-e", filter=nav)
def _(event):
    """Scroll one line down; cursor stays put unless pushed off-screen."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or n <= h:
        return
    state.top = min(state.top + 1, max(0, n - h))
    if state.cursor < state.top + SCROLLOFF:
        state.cursor = min(state.top + SCROLLOFF, n - 1)
    state.follow_viewport()


@kb.add("c-y", filter=nav)
def _(event):
    """Scroll one line up; cursor stays put unless pushed off-screen."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or n <= h:
        return
    state.top = max(state.top - 1, 0)
    if state.cursor > state.top + h - 1 - SCROLLOFF:
        state.cursor = max(state.top + h - 1 - SCROLLOFF, 0)
    state.follow_viewport()


@kb.add("z", "z", filter=nav)
def _(event):
    """Center the cursor line in the viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor - h // 2, max(0, n - h)))


@kb.add("z", "t", filter=nav)
def _(event):
    """Cursor line to top of viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor, max(0, n - h)))


@kb.add("z", "b", filter=nav)
def _(event):
    """Cursor line to bottom of viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0:
        return
    state.top = max(0, min(state.cursor - h + 1, max(0, n - h)))


@kb.add("H", filter=nav)
def _(event):
    """Cursor to the high (top, +scrolloff) row of the viewport."""
    _clear_pending()
    h = list_height()
    if h <= 0 or not state.rows:
        return
    state.cursor = min(state.top + SCROLLOFF, len(state.rows) - 1) \
        if state.top > 0 else state.top


@kb.add("M", filter=nav)
def _(event):
    """Cursor to the middle row of the viewport."""
    _clear_pending()
    h = list_height()
    if h <= 0 or not state.rows:
        return
    visible = min(h, len(state.rows) - state.top)
    state.cursor = min(state.top + visible // 2, len(state.rows) - 1)


@kb.add("L", filter=nav)
def _(event):
    """Cursor to the low (bottom, -scrolloff) row of the viewport."""
    _clear_pending()
    h = list_height()
    n = len(state.rows)
    if h <= 0 or not n:
        return
    bottom = min(state.top + h - 1, n - 1)
    state.cursor = max(bottom - SCROLLOFF, state.top) if bottom < n - 1 else bottom


_seen_this_session = set()


def _note_open(key):
    """Count opening an entry as usage, once per key per session."""
    if key not in _seen_this_session:
        _seen_this_session.add(key)
        bump(key)


@kb.add("l", filter=nav)
@kb.add("enter", filter=nav)
def _(event):
    cur = state.selected()
    if cur:
        state.focus = "fields"
        state.fidx = 0
        _note_open(cur[:2])


@kb.add("h", filter=nav)
@kb.add("escape", filter=nav)
def _(event):
    state.focus = "list"


def _enter_search(event, pos="keep", clear=False):
    """Put the caret back in the search line (vi insert-entry keys).

    pos: "keep" (i), "after" (a), "end" (A), "start" (I).
    """
    state.focus = "list"
    state.input_target = "search"
    buf = state.search_buffer
    if clear:
        buf.text = ""          # .text=, not .reset() — reset skips on_text_changed
    if pos == "end":
        buf.cursor_position = len(buf.text)
    elif pos == "start":
        buf.cursor_position = 0
    elif pos == "after":
        buf.cursor_position = min(buf.cursor_position + 1, len(buf.text))
    event.app.layout.focus(buf)
    event.app.vi_state.input_mode = InputMode.INSERT


@kb.add("i", filter=nav)
def _(event):
    """Insert at the cursor."""
    _enter_search(event, pos="keep")


@kb.add("a", filter=nav)
def _(event):
    """Append after the cursor."""
    _enter_search(event, pos="after")


@kb.add("A", filter=nav)
def _(event):
    """Append at end of line."""
    _enter_search(event, pos="end")


@kb.add("I", filter=nav)
def _(event):
    """Insert at the start of the line."""
    _enter_search(event, pos="start")


@kb.add("c", "c", filter=nav)
@kb.add("S", filter=nav)
def _(event):
    """Change the whole query: clear it and start typing."""
    _enter_search(event, pos="end", clear=True)


@kb.add("y", filter=nav)
def _(event):
    cur = state.selected()
    if not cur:
        return
    key = cur[:2]
    # decrypt_all() warmed every entry at startup, so there's no cold-yank
    # wait left to announce here — fields.get()/.wait() is a plain dict hit.
    if state.focus == "fields":
        rows = fields.wait(key) or []
        if not rows or state.fidx >= len(rows):
            return
        label, value = rows[state.fidx]
        copy(value)  # raw text — collapse() is a display transform only
        state.status = f"yanked {label}"
    else:
        pw = run(["rbw", "get", cur[0]] + ([cur[1]] if cur[1] else [])).stdout.strip()
        if pw:
            copy(pw)
            state.status = "yanked password"
    bump(key)


@kb.add("r", filter=nav)
def _(event):
    cur = state.selected()
    if not cur or state.focus != "fields":
        return
    rows = fields.get(cur[:2]) or []
    if state.fidx >= len(rows):
        return
    label = rows[state.fidx][0]
    rkey = (cur[0], cur[1], label)
    state.revealed ^= {rkey}


@kb.add("e", filter=nav)
def _(event):
    cur = state.selected()
    if not cur:
        return
    key = cur[:2]
    edit(key)
    refresh_after_write()
    state.status = "edited (rbw edit covers password + notes only)"


@kb.add("d", "d", filter=nav)
def _(event):
    """Clear the search line (vim's dd on the one editable line here)."""
    state.cursor = 0
    # .text = "" (not .reset(), which bypasses the document setter and
    # never fires on_text_changed) -> refilter() runs, re-clamps cursor.
    state.search_buffer.text = ""
    state.status = ""


@kb.add("D", "D", filter=nav)
def _(event):
    """Arm entry deletion. Deliberately not dd — that clears the search."""
    cur = state.selected()
    if not cur:
        return
    state.pending_delete = cur[:2]
    state.status = f"delete '{display_name(cur[0]).strip()}'? press Y to confirm"


@kb.add("Y", filter=nav)
def _(event):
    cur = state.selected()
    if not cur or state.pending_delete != cur[:2]:
        return
    key = cur[:2]
    r = remove(key)
    if r.returncode == 0:
        state.entries = [e for e in state.entries if e[:2] != key]
        fields.invalidate(key)
        state.refilter()
        state.status = f"deleted {display_name(cur[0]).strip()}"
    else:
        state.status = f"delete failed: {r.stderr.strip()[:50]}"
    state.pending_delete = None


@kb.add("s", filter=nav)
def _(event):
    _clear_pending()
    sync()
    refresh_after_write()
    state.status = "synced"


@kb.add("/", filter=nav)
def _(event):
    """Search within the open entry's fields.

    The list is already filtered by plain typing, so `/` addresses the
    detail pane instead — jump to the next field whose label or value
    matches. Focuses the field pane if not already there.
    """
    cur = state.selected()
    if not cur:
        return
    state.focus = "fields"
    state.input_target = "field_search"
    state.field_query = ""
    event.app.vi_state.input_mode = InputMode.INSERT


@kb.add("c-u", filter=ins_field)
def _(event):
    # field_search only — it's a plain string, not a Buffer. ins_field
    # excludes target=="search" so this can't shadow the Buffer's own vi
    # binding (unix-line-discard), which already handles ctrl-u natively
    # for the real search Buffer — no code needed here for that case.
    state.field_query = ""


# ── Keychain-save consent — one-shot status-line prompt, not a GUI dialog ──
# Gated by `awaiting_consent` instead of `nav` so these keys fully pre-empt
# their normal bindings (y=yank, n/N=nothing normally, esc=leave-search)
# for exactly the one interaction where this question is live. Default is
# No: enter, esc, n/N, or anything else all decline; only 'y' saves.

@kb.add("y", filter=awaiting_consent)
def _(event):
    _resolve_keychain_consent(event.app, save=True)


@kb.add("n", filter=awaiting_consent)
@kb.add("N", filter=awaiting_consent)
@kb.add("enter", filter=awaiting_consent)
@kb.add("escape", filter=awaiting_consent)
def _(event):
    _resolve_keychain_consent(event.app, save=False)


@kb.add("<any>", filter=awaiting_consent)
def _(event):
    """Any other key while the prompt is up also declines — same as N."""
    _resolve_keychain_consent(event.app, save=False)


@kb.add("?", filter=nav)
def _(event):
    state.help = not state.help


@kb.add("q", filter=nav)
def _(event):
    event.app.exit()
    os._exit(0)


@kb.add("Q", filter=nav)
def _(event):
    event.app.exit()
    os._exit(0)


@kb.add("escape", filter=ins)
@kb.add("enter", filter=ins)
def _(event):
    # Leaving the search line must NOT clear the query (issue #10) — only
    # field_search's transient jump-query gets wiped. The search Buffer's
    # own text is untouched; refocus the list so vi motions go back to nav.
    event.app.vi_state.input_mode = InputMode.NAVIGATION
    state.input_target = "search"
    state.field_query = ""
    if state.focus == "list":
        event.app.layout.focus(list_window)


@kb.add("backspace", filter=ins_field)
def _(event):
    # field_search only — the search Buffer handles its own backspace via
    # prompt_toolkit's default vi bindings when focused (ins_field excludes
    # it, so this binding doesn't even match and can't steal the keypress).
    state.field_query = state.field_query[:-1]
    _jump_to_field()


@kb.add("<any>", filter=ins_field)
def _(event):
    # field_search only — the search Buffer handles its own typing (and
    # dw/cw/paste/undo/...) via prompt_toolkit's default vi bindings when
    # focused; on_text_changed drives refilter() for it. ins_field excludes
    # target=="search" so this can't shadow the Buffer's own <any> handler.
    ch = event.data
    if not ch or not ch.isprintable():
        return
    state.field_query += ch
    _jump_to_field()


def _jump_to_field():
    """Move fidx to the first field matching field_query. No wrap, no-op on miss."""
    cur = state.selected()
    if not cur or not state.field_query:
        return
    q = state.field_query.lower()
    for i, (label, value) in enumerate(fields.get(cur[:2]) or []):
        if q in label.lower() or q in str(value).lower():
            state.fidx = i
            return


# ── 7. main ──────────────────────────────────────────────────────────────────

def _remove_stale_plaintext_cache():
    """One-time cleanup: a pre-in-process-decrypt version of this tool wrote
    every field, in plaintext, to $TMPDIR/bwvault-fields.json. That file is
    now pointless (nothing reads or writes it) and holds live secrets on
    disk, so remove it on startup if a previous run left one behind."""
    try:
        os.remove(FIELDS_JSON)
    except FileNotFoundError:
        pass
    except OSError:
        pass  # best-effort; a leftover file is a warning, not fatal


_pending_consent = {"email": None, "pw": None}   # cleared the instant it resolves


def _offer_keychain_save(email, pw, status_suffix=""):
    """Arm the one-shot status-line consent prompt (see the `awaiting_consent`
    key bindings). The password is held in _pending_consent only until the
    user answers — y/n/enter/esc/anything all resolve it immediately.
    """
    _pending_consent["email"] = email
    _pending_consent["pw"] = pw
    state.awaiting_keychain_consent = True
    state.status = ("Save master password to Keychain so this stops asking?"
                    f"  y / N{status_suffix}")


def _resolve_keychain_consent(app, save):
    email = _pending_consent["email"]
    pw = _pending_consent["pw"]
    _pending_consent["email"] = None
    _pending_consent["pw"] = None          # discarded now, either way
    state.awaiting_keychain_consent = False
    if save and email and pw:
        try:
            vc.keychain_set(email, pw)
            state.status = "saved to Keychain — won't ask again on launch"
        except Exception as exc:
            state.status = f"Keychain save failed: {exc} — will ask again next launch"
    else:
        vc.record_keychain_decline()
        state.status = "not saved — won't ask again"
    pw = None


def refresh_after_write():
    """Re-run decrypt_all after e/s/Y so the cache reflects what rbw wrote.

    Re-unlocks (Keychain first, same as startup) — the master password is
    never retained past derive_keys() on this path, so a refresh has no
    choice but to ask again if there's no Keychain item. Cancelling just
    keeps the pre-write cache (stale but not wrong about anything the user
    didn't just change locally). The one-time save-to-Keychain offer only
    ever fires from main() at startup, never here — mid-session isn't the
    place to interrupt with that question again.
    """
    result = unlock_and_decrypt()
    if result is None:
        state.status = "refresh cancelled — fields may be stale, press s to retry"
        return
    cache, skipped, _email, _pw_for_consent = result
    fields.clear(seed=cache)
    state.entries = entries_from_cache(cache)
    state.refilter()
    if skipped:
        state.status = f"refreshed ({skipped} entries could not be read)"


def build_app():
    global list_window
    style = Style.from_dict({
        "sel": "reverse",
        "cur": "bold",
        "title": "bold #89b4fa",
        "key": "#f9e2af",
        "mode": "bg:#a6e3a1 #1e1e2e bold",
        "imode": "bg:#f9e2af #1e1e2e bold",
        "dim": "#6c7086",
        "status": "#f38ba8",
        "sep": "#45475a",
        "query": "#cdd6f4 bold",
        "searchon": "bg:#89b4fa #1e1e2e bold",
        "fieldon": "bg:#f9e2af #1e1e2e bold",
    })

    # Real vi-modal line editor for the LIST filter (issue #10). refilter()
    # hooks on_text_changed so filtering stays live regardless of HOW the
    # text changed — typed, pasted, dw/cw'd, or undone.
    state.search_buffer = Buffer(multiline=False,
                                  on_text_changed=lambda buf: state.refilter())

    def search_label_text():
        return search_label(state, _app)

    def search_count_text():
        return search_count(state)

    def search_field_text_fn():
        return search_field_text(state, _app)

    def list_text():
        return list_view(state, fields)

    def detail_text():
        if state.help:
            return help_view()
        return field_view(state, fields)

    def status_text():
        return status_view(state, _app, fields)

    in_field_search = Condition(lambda: state.input_target == "field_search")

    search_window = Window(
        BufferControl(buffer=state.search_buffer,
                      input_processors=[BeforeInput(" ")]),
        height=1)

    list_window = Window(FormattedTextControl(list_text), width=D(preferred=54))

    bar = VSplit([
        Window(FormattedTextControl(search_label_text), dont_extend_width=True),
        ConditionalContainer(search_window, filter=~in_field_search),
        ConditionalContainer(Window(FormattedTextControl(search_field_text_fn)),
                             filter=in_field_search),
        Window(FormattedTextControl(search_count_text), dont_extend_width=True,
              align=WindowAlign.RIGHT),
    ], height=1)

    layout = Layout(HSplit([
        bar,
        VSplit([
            list_window,
            Window(width=1, char="│", style="class:sep"),
            Window(FormattedTextControl(detail_text)),
        ]),
        Window(FormattedTextControl(status_text), height=1),
    ]))

    return Application(layout=layout, key_bindings=kb, style=style,
                       full_screen=True, mouse_support=False,
                       editing_mode=EditingMode.VI)


def _on_hup(_sig, _frm):
    os._exit(0)


def main():
    global state, fields, _app

    if "--check" in sys.argv:
        run_self_check()
        return

    _remove_stale_plaintext_cache()

    # Unlock once, decrypt everything. Every entry is warm from here on;
    # there is no hydration path left to fall back to.
    result = unlock_and_decrypt()
    if result is None:
        print("vault-tui: unlock cancelled — no Keychain item and no "
              "password entered at the prompt", file=sys.stderr)
        sys.exit(1)
    cache, skipped, email, pw_for_consent = result

    entries = entries_from_cache(cache)
    fields = Fields(seed=cache)

    # state + application
    state = State(entries)
    _app = build_app()

    # The Keychain-save question takes priority for the status line on
    # first render (it needs an answer; the skipped-count note doesn't) —
    # but don't lose the skipped-count entirely if both are true.
    if pw_for_consent is not None:
        suffix = f"  ({skipped} entries could not be decrypted)" if skipped else ""
        _offer_keychain_save(email, pw_for_consent, status_suffix=suffix)
    elif skipped:
        state.status = f"{skipped} entries could not be decrypted (skipped)"

    # vault-popup locates this window by title.
    sys.stdout.write("\033]0;bwvault\007")
    sys.stdout.flush()

    global LAST_USED
    LAST_USED = load_last_used()

    def pre_run():
        # Start in search: the picker is opened to find something, so the
        # first keystroke should filter. esc drops to NORMAL for vim keys.
        # (run() resets vi_state, so this must happen once live, not at
        # construction time.)
        _app.vi_state.input_mode = InputMode.INSERT
        state.input_target = "search"
        _app.layout.focus(state.search_buffer)

    signal.signal(signal.SIGHUP, _on_hup)
    signal.signal(signal.SIGTERM, _on_hup)

    # 6/7
    _app.run(pre_run=pre_run)


# ── self-check ───────────────────────────────────────────────────────────────

def _vc_check():
    """Synthetic-vault crypto assertions. No real vault, no real password."""
    import base64
    import hashlib
    import hmac
    import secrets

    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import padding, rsa

    def encrypt(plaintext, enc, mac_key):
        """Inverse of vc.unwrap() — fixture-only, never used at runtime."""
        iv = secrets.token_bytes(16)
        pt = plaintext if isinstance(plaintext, bytes) else plaintext.encode()
        pad = 16 - (len(pt) % 16)
        pt += bytes([pad]) * pad
        cipher = vc.Cipher(vc.algorithms.AES(enc), vc.modes.CBC(iv)).encryptor()
        ct = cipher.update(pt) + cipher.finalize()
        m = hmac.new(mac_key, iv + ct, hashlib.sha256).digest()
        return "2." + "|".join(base64.b64encode(x).decode() for x in (iv, ct, m))

    # -- round trip: encrypt a known string, unwrap() returns it ------------
    enc, mac = secrets.token_bytes(32), secrets.token_bytes(32)
    cs = encrypt("hello world", enc, mac)
    assert vc.unwrap_text(cs, enc, mac) == "hello world"
    print("PASS: round-trip encrypt -> unwrap")

    # -- MAC mismatch returns None, never raises -----------------------------
    bad = cs[:-4] + "AAAA"
    assert vc.unwrap(bad, enc, mac) is None
    assert vc.unwrap("garbage not even a cipherstring", enc, mac) is None
    assert vc.unwrap(None, enc, mac) is None
    print("PASS: MAC mismatch / malformed cipherstring -> None, no raise")

    # -- per-cipher key path: entry.key overrides the account key -----------
    acct_enc, acct_mac = secrets.token_bytes(32), secrets.token_bytes(32)
    own_enc, own_mac = secrets.token_bytes(32), secrets.token_bytes(32)
    wrapped_key = encrypt(own_enc + own_mac, acct_enc, acct_mac)
    entry = {"key": wrapped_key, "name": encrypt("per-cipher entry", own_enc, own_mac)}
    ek, mk = vc.entry_keys(entry, (acct_enc, acct_mac), {})
    assert (ek, mk) == (own_enc, own_mac)
    assert vc.unwrap_text(entry["name"], ek, mk) == "per-cipher entry"
    # decrypting with the ACCOUNT key instead must fail (proves it's really
    # using the per-cipher key, not silently falling back)
    assert vc.unwrap(entry["name"], acct_enc, acct_mac) is None
    print("PASS: per-cipher key path uses the unwrapped entry key")

    # -- org path: entry.org_id selects the org key -------------------------
    org_enc, org_mac = secrets.token_bytes(32), secrets.token_bytes(32)
    org_entry = {"org_id": "org-1", "name": encrypt("org entry", org_enc, org_mac)}
    ek2, mk2 = vc.entry_keys(org_entry, (acct_enc, acct_mac), {"org-1": (org_enc, org_mac)})
    assert (ek2, mk2) == (org_enc, org_mac)
    assert vc.unwrap_text(org_entry["name"], ek2, mk2) == "org entry"
    print("PASS: org_id path selects the org key")

    # -- RSA-OAEP org-key unwrap (type "4.") end to end ----------------------
    priv = rsa.generate_private_key(public_exponent=65537, key_size=2048)
    der = priv.private_bytes(encoding=serialization.Encoding.DER,
                             format=serialization.PrivateFormat.PKCS8,
                             encryption_algorithm=serialization.NoEncryption())
    ppk_cs = encrypt(der, acct_enc, acct_mac)
    loaded_priv = vc.account_private_key(ppk_cs, acct_enc, acct_mac)
    assert loaded_priv is not None
    raw_org_key = org_enc + org_mac
    ct = loaded_priv.public_key().encrypt(raw_org_key, padding.OAEP(
        mgf=padding.MGF1(algorithm=hashes.SHA1()), algorithm=hashes.SHA1(), label=None))
    org_blob = "4." + base64.b64encode(ct).decode()
    keys = vc.org_sym_keys({"org-1": org_blob}, loaded_priv)
    assert keys["org-1"] == (org_enc, org_mac)
    print("PASS: protected_private_key + protected_org_keys RSA-OAEP unwrap")

    # -- decrypt_all: full synthetic db, corrupt cipher skipped, Note entry,
    #    EMPTY NAME (valid decrypt, must NOT count as skipped — rbw's own
    #    `list` once discarded 1223 real entries by mistaking exactly this
    #    for a decrypt failure) --------------------------------------------
    # Reuse (acct_enc, acct_mac) as the account/db-level "sym" here — it's
    # the same pair `wrapped_key` (above) was wrapped with, so the
    # per-cipher entry's `key` field actually unwraps against what
    # decrypt_all() passes as the account keys, matching how a real vault's
    # entry.key is always wrapped with THAT vault's own account key.
    sym = (acct_enc, acct_mac)
    db_entries = [
        {"name": encrypt("plain login", *sym),
         "data": {"Login": {"username": encrypt("bob", *sym),
                            "password": encrypt("hunter2", *sym),
                            "totp": None, "uris": []}}},
        {"name": encrypt("note entry", *sym), "data": None,
         "notes": encrypt("secret note text", *sym)},
        {"name": encrypt("per-cipher entry", own_enc, own_mac), "key": wrapped_key,
         "data": None},
        {"name": encrypt("org entry", org_enc, org_mac), "org_id": "org-1",
         "data": None},
        {"name": encrypt("", *sym), "data": None},   # genuinely empty name
        {"name": "2.corrupt|not-valid-base64!!|also-bad", "data": None},
    ]
    fake_db = {"entries": db_entries}
    cache, skipped = vc.decrypt_all(fake_db, sym, {"org-1": (org_enc, org_mac)})
    assert skipped == 1, f"expected 1 skipped (corrupt cipher only), got {skipped}"
    assert ("plain login", "bob") in cache
    assert cache[("plain login", "bob")] == \
        [("username", "bob"), ("password", "hunter2")]
    assert ("note entry", "") in cache, "Note entry (data: null) must not crash"
    assert cache[("note entry", "")] == [("notes", "secret note text")]
    assert ("per-cipher entry", "") in cache, "per-cipher entry via decrypt_all"
    assert ("org entry", "") in cache, "org entry via decrypt_all"
    assert ("", "") in cache, \
        "empty-name entry must be present, not dropped as a failure"
    print(f"PASS: decrypt_all — {len(cache)} entries ok, skipped={skipped} "
          "(corrupt cipher skipped, empty name kept as valid)")

    # display_name() (vault-tui, not vault_crypto) is what turns that empty
    # key into something showable — proven directly, not through decrypt_all.
    assert display_name("") == UNNAMED
    assert display_name("   ") == UNNAMED
    assert display_name("real name") == "real name"
    print("PASS: display_name() renders empty/whitespace names as UNNAMED")


def _write_fake_pinentry(script_body):
    """A tiny executable python script speaking just enough Assuan to test
    prompt_password() — no GUI, no real pinentry-mac binary involved."""
    path = tempfile.mktemp(suffix="_fake_pinentry.py")
    with open(path, "w") as fh:
        fh.write(f"#!{sys.executable}\n" + script_body)
    os.chmod(path, 0o700)
    return path


def _pinentry_check():
    """Assuan protocol parsing against a FAKE pinentry — no GUI, no real binary."""
    ok_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    line = line.strip()\n"
        "    if line.startswith('GETPIN'):\n"
        "        print('D fake-password-123'); print('OK')\n"
        "    elif line.startswith('BYE'):\n"
        "        print('OK'); sys.stdout.flush(); break\n"
        "    else:\n"
        "        print('OK')\n"
        "    sys.stdout.flush()\n"
    )
    path = _write_fake_pinentry(ok_script)
    try:
        pin = vc.prompt_password(path, desc="vault-tui --check", prompt="PIN:")
        assert pin == "fake-password-123", f"got {pin!r}"
        print("PASS: pinentry Assuan protocol parses SETDESC/SETPROMPT/GETPIN/BYE")
    finally:
        os.unlink(path)

    cancel_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    if line.strip().startswith('GETPIN'):\n"
        "        print('ERR 83886179 Operation cancelled'); sys.stdout.flush(); break\n"
        "    print('OK'); sys.stdout.flush()\n"
    )
    path2 = _write_fake_pinentry(cancel_script)
    try:
        cancelled = False
        try:
            vc.prompt_password(path2, desc="x", prompt="x")
        except vc.PinentryCancelled:
            cancelled = True
        assert cancelled, "ERR from pinentry should raise PinentryCancelled"
        print("PASS: pinentry cancel (ERR) raises PinentryCancelled cleanly")
    finally:
        os.unlink(path2)


def _keychain_check():
    """Keychain-first / pinentry-fallback / consent-marker logic, entirely
    against IN-PROCESS FAKES. No subprocess, no `security` binary call, no
    real Keychain access, no GUI dialog — get_master_password()'s
    keychain_get_fn parameter and keychain_set() are both plain Python
    callables here, never exec'd.
    """
    calls = []

    def fake_hit(email):
        calls.append(("get", email))
        return "keychain-password-xyz"

    def fake_pinentry_should_not_run(*a, **kw):
        raise AssertionError("pinentry must not run when the Keychain hits")

    pw, from_keychain = vc.get_master_password(
        "user@example.com", pinentry_path="unused", keychain_get_fn=fake_hit)
    assert pw == "keychain-password-xyz" and from_keychain is True
    assert calls == [("get", "user@example.com")]
    print("PASS: keychain hit derives keys without invoking pinentry")

    def fake_miss(email):
        calls.append(("get", email))
        return None

    ok_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    line = line.strip()\n"
        "    if line.startswith('SETDESC'):\n"
        "        sys.stderr.write(line + chr(10))\n"
        "    if line.startswith('GETPIN'):\n"
        "        print('D fallback-password'); print('OK')\n"
        "    elif line.startswith('BYE'):\n"
        "        print('OK'); sys.stdout.flush(); break\n"
        "    else:\n"
        "        print('OK')\n"
        "    sys.stdout.flush()\n"
    )
    path = _write_fake_pinentry(ok_script)
    try:
        calls.clear()
        pw2, from_keychain2 = vc.get_master_password(
            "someone@pm.me", pinentry_path=path, keychain_get_fn=fake_miss)
        assert pw2 == "fallback-password" and from_keychain2 is False
        assert calls == [("get", "someone@pm.me")]
        print("PASS: keychain miss falls through to pinentry")

        # SETDESC must name the account (stderr-echoed by the fake above).
        r = subprocess.run([path], input="SETDESC Unlock vault for someone@pm.me\nBYE\n",
                           capture_output=True, text=True, timeout=5)
        assert "someone@pm.me" in r.stderr
        print("PASS: SETDESC text contains the configured email")
    finally:
        os.unlink(path)

    # both paths failing -> PinentryCancelled, not a raw traceback
    cancel_script = (
        "import sys\n"
        "print('OK Pleased to meet you'); sys.stdout.flush()\n"
        "for line in sys.stdin:\n"
        "    if line.strip().startswith('GETPIN'):\n"
        "        print('ERR 83886179 cancelled'); sys.stdout.flush(); break\n"
        "    print('OK'); sys.stdout.flush()\n"
    )
    path3 = _write_fake_pinentry(cancel_script)
    try:
        cancelled = False
        try:
            vc.get_master_password("nobody@pm.me", pinentry_path=path3,
                                   keychain_get_fn=fake_miss)
        except vc.PinentryCancelled:
            cancelled = True
        assert cancelled, "keychain miss + pinentry cancel must raise cleanly"
        print("PASS: both unlock paths failing -> clean PinentryCancelled, no traceback")
    finally:
        os.unlink(path3)

    # keychain_set: consent "y" calls it with the right service/account (via
    # _resolve_keychain_consent's contract) — checked directly on the
    # function's own argument-passing, no real `security` invocation.
    set_calls = []

    def fake_set_ok(email, password, service="vault-tui"):
        set_calls.append((service, email, password))

    fake_set_ok("consent@pm.me", "the-password")
    assert set_calls == [("vault-tui", "consent@pm.me", "the-password")]
    print("PASS: keychain_set call shape matches (service, email, password)")

    def fake_set_raises(email, password, service="vault-tui"):
        raise RuntimeError("security: item already exists, denied")

    raised = False
    try:
        fake_set_raises("x@pm.me", "pw")
    except RuntimeError:
        raised = True
    assert raised, "a failing keychain_set must be catchable, not silently swallowed"
    print("PASS: keychain_set failure is a catchable exception, not a crash")

    # has_declined_keychain() / record_keychain_decline(): marker file in a
    # throwaway HOME so this never touches the real
    # ~/.local/share/vault-tui/no-keychain.
    import tempfile as _tempfile
    real_marker = vc.NO_KEYCHAIN_MARKER
    tmp_home = _tempfile.mkdtemp()
    try:
        vc.NO_KEYCHAIN_MARKER = os.path.join(tmp_home, "no-keychain")
        assert vc.has_declined_keychain() is False
        vc.record_keychain_decline()
        assert vc.has_declined_keychain() is True
        print("PASS: decline marker persists has_declined_keychain() -> True")
    finally:
        vc.NO_KEYCHAIN_MARKER = real_marker


def run_self_check():
    _vc_check()
    _pinentry_check()
    _keychain_check()

    # -- Fields: plain warm-cache wrapper, no worker -------------------------
    seed = {
        (" leading", "u"): [("password", "p")],
        ("has\ttab", ""): [("username", "x")],
        ("note-entry", ""): [("notes", "line1\nline2\nline3")],
    }
    f = Fields(seed=seed)
    assert f.get((" leading", "u")) == [("password", "p")]
    assert f.get(("has\ttab", "")) == [("username", "x")]
    assert f.wait(("note-entry", ""))[0][1] == "line1\nline2\nline3"
    assert f.get(("missing", "")) is None
    f.invalidate((" leading", "u"))
    assert f.get((" leading", "u")) is None
    f.clear(seed={("re-seeded", ""): [("x", "1")]})
    assert f.get(("re-seeded", "")) == [("x", "1")]
    assert f.get((" leading", "u")) is None, "clear() replaces the whole cache"
    print("PASS: Fields is a plain synchronous warm-cache wrapper")

    # -- search Buffer: real vi-modal line editor (issue #10) --------------
    # State.search_buffer is a live prompt_toolkit Buffer; refilter() is
    # wired to its on_text_changed, so ANY edit path (typed, pasted, vi
    # motion/operator, undo) keeps the list filter live without a special
    # case per input method. Verified via direct Buffer/State calls, not
    # pty screen-scraping (misled 3x earlier today).
    entries_fixture = [("github", "u1", ""), ("gitlab", "u2", ""),
                        ("aws-console", "u3", "")]
    check_state = State(list(entries_fixture))
    check_state.search_buffer = Buffer(
        multiline=False, on_text_changed=lambda buf: check_state.refilter())

    # 1. typing into the buffer filters the list (text change -> rows shrink)
    assert len(check_state.rows) == 3
    check_state.search_buffer.insert_text("git")
    assert check_state.query == "git"
    assert len(check_state.rows) == 2, check_state.rows
    assert all("git" in r[0] for r in check_state.rows)
    print("PASS: typing into search Buffer filters the list live")

    # 2. mid-string edit: "gthub" -> cursor to index 1 -> insert "i" -> "github"
    check_state.search_buffer.text = ""
    check_state.search_buffer.insert_text("gthub")
    check_state.search_buffer.cursor_position = 1
    check_state.search_buffer.insert_text("i")
    assert check_state.query == "github", check_state.query
    assert len(check_state.rows) == 1 and check_state.rows[0][0] == "github"
    print("PASS: mid-string edit ('gthub' -> insert at idx1 -> 'github') refilters")

    # 3. dw-style deletion via REAL vi key bindings (not a hand substitute)
    # dispatches through prompt_toolkit's own Application + vi bindings
    # against a focused Buffer, exactly as build_app() wires the live UI.
    async def _check_dw():
        from prompt_toolkit.input.defaults import create_pipe_input
        from prompt_toolkit.output import DummyOutput

        dw_state = State(list(entries_fixture))
        buf = Buffer(multiline=False,
                     on_text_changed=lambda b: dw_state.refilter())
        dw_state.search_buffer = buf
        buf.insert_text("git hub")
        buf.cursor_position = 0

        win = Window(BufferControl(buffer=buf))
        app = Application(layout=Layout(win), editing_mode=EditingMode.VI,
                          full_screen=False)
        with create_pipe_input() as pipe_input:
            app.input = pipe_input
            app.output = DummyOutput()

            def pre_run():
                app.vi_state.input_mode = InputMode.NAVIGATION
                app.layout.focus(buf)

            task = asyncio.ensure_future(app.run_async(pre_run=pre_run))
            await asyncio.sleep(0.05)
            pipe_input.send_text("dw")   # vi: delete "git " -> "hub"
            await asyncio.sleep(0.05)
            app.exit()
            await asyncio.sleep(0.02)
            try:
                await task
            except BaseException:
                pass
        return dw_state, buf

    # Running a real Application prints inline-render escapes to the real
    # terminal even with app.output = DummyOutput() (rendering happens on
    # the raw fd, not through the Output abstraction, for this pt version);
    # swallow it so --check output stays legible. Assertions below are the
    # actual evidence, not this cosmetic capture.
    import asyncio
    import contextlib
    import io
    with contextlib.redirect_stdout(io.StringIO()), \
            contextlib.redirect_stderr(io.StringIO()):
        dw_state, dw_buf = asyncio.run(_check_dw())
    assert dw_buf.text == "hub", f"dw should leave 'hub', got {dw_buf.text!r}"
    assert dw_state.query == "hub"
    assert len(dw_state.rows) == 1 and dw_state.rows[0][0] == "github"
    print("PASS: dw via real vi bindings deletes word and refilters live")

    # 4. clearing the buffer restores all rows
    check_state.search_buffer.text = ""
    assert check_state.query == ""
    assert len(check_state.rows) == len(entries_fixture)
    print("PASS: clearing search Buffer restores all rows")

    # -- viewport / scroll (issue #11) --------------------------------------
    # Real headless Application via build_app() itself, so key dispatch goes
    # through the actual `kb` bindings and list_height() reads a real
    # DummyOutput size (40 rows -> list_height() == 38), not a guess.
    global state, fields, _app

    def _viewport_check():
        from prompt_toolkit.input.defaults import create_pipe_input
        from prompt_toolkit.output import DummyOutput

        big_entries = [(f"entry-{i:04d}", "u", "") for i in range(1223)]

        async def _run(keys, before=None):
            global state, fields, _app
            state = State(list(big_entries))
            fields = Fields(seed={})
            _app = build_app()
            if before:
                before()
            with create_pipe_input() as pipe_input:
                _app.input = pipe_input
                _app.output = DummyOutput()

                def pre_run():
                    _app.vi_state.input_mode = InputMode.NAVIGATION
                    _app.layout.focus(list_window)

                task = asyncio.ensure_future(_app.run_async(pre_run=pre_run))
                await asyncio.sleep(0.05)
                pipe_input.send_text(keys)
                await asyncio.sleep(0.05)
                _app.exit()
                await asyncio.sleep(0.02)
                try:
                    await task
                except BaseException:
                    pass

        with contextlib.redirect_stdout(io.StringIO()), \
                contextlib.redirect_stderr(io.StringIO()):
            asyncio.run(_run(""))
            h = list_height()
            assert h == 38, f"expected list_height()==38 for 40-row DummyOutput, got {h}"

            # list_view() returns at most `height` rows, not all 1223
            rendered = list_view(state, fields)
            assert len(rendered) <= h, \
                f"list_view() returned {len(rendered)} rows, expected <= {h}"
            assert len(rendered) < len(big_entries)

            # G -> viewport contains the last row, cursor visible within it
            asyncio.run(_run("G"))
            last = len(state.rows) - 1
            assert state.cursor == last
            assert state.top <= state.cursor < state.top + h, \
                f"cursor {state.cursor} not within viewport [{state.top}, {state.top + h})"
            assert state.top + h - 1 == last, \
                "G should pin the bottom of the viewport to the last row"

            # ctrl-d moves cursor ~half a page and the viewport follows
            asyncio.run(_run("\x04"))   # ctrl-d, cursor starts at 0
            half = h // 2
            assert state.cursor == half, f"ctrl-d: expected cursor {half}, got {state.cursor}"
            assert state.top <= state.cursor < state.top + h

            # zz centers the cursor line in the viewport
            def _seek_mid():
                state.cursor = 500
            asyncio.run(_run("zz", before=_seek_mid))
            assert state.top == max(0, 500 - h // 2), \
                f"zz: expected top {500 - h // 2}, got {state.top}"
            assert state.top <= 500 < state.top + h

            # scrolloff: moving to within 3 rows of the TOP edge scrolls the
            # view rather than pinning (mid-list, so there's room on both
            # sides — unlike the data-boundary case at row 0 or `last`).
            top_before_holder = {}

            def _seek_scrolloff_edge():
                state.cursor = 500
                state.follow_viewport()          # settle top, room on both sides
                state.cursor = state.top + SCROLLOFF   # exactly at the top margin
                top_before_holder["top"] = state.top
            asyncio.run(_run("k", before=_seek_scrolloff_edge))
            top_before = top_before_holder["top"]
            assert state.cursor == top_before + SCROLLOFF - 1
            assert state.top == top_before - 1, \
                (f"cursor at scrolloff margin: k should scroll top by 1 "
                 f"(expected {top_before - 1}, got {state.top})")

            # refilter() with a query shrinking rows below the viewport clamps
            # both cursor AND viewport
            def _seek_and_query():
                state.cursor = 900
                state.follow_viewport()
                state.search_buffer.text = "entry-0001"  # 1 match after prefix collapse -> few matches
            asyncio.run(_run("", before=_seek_and_query))
            assert len(state.rows) < h, "fixture query expected to shrink below viewport height"
            assert state.cursor == len(state.rows) - 1
            assert state.top == 0, f"top should clamp to 0 for a short list, got {state.top}"

        print("PASS: list_height()==38 for headless 40-row DummyOutput")
        print(f"PASS: list_view() returns <= height rows ({len(rendered)} <= {h}, "
              f"was 1223 pre-viewport)")
        print("PASS: G scrolls viewport to show the last row, cursor visible")
        print("PASS: ctrl-d moves cursor ~half page, viewport follows")
        print("PASS: zz centers the cursor line in the viewport")
        print("PASS: scrolloff holds — cursor near edge scrolls, viewport not pinned")
        print("PASS: refilter() clamps both cursor and viewport when rows shrink")

    _viewport_check()

    print("ALL CHECKS PASSED")


if __name__ == "__main__":
    main()
