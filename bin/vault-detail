#!/usr/bin/env python3
"""Flatten one rbw entry into "label<TAB>value" rows for the field picker.

Handles all four Bitwarden types. Note entries carry data: null, and every
data value can be null, so nothing here assumes a key is present.
"""
import json
import subprocess
import sys

LOGIN = ["username", "password", "totp"]
CARD = ["cardholder_name", "brand", "number", "code", "exp_month", "exp_year"]
IDENT = ["title", "first_name", "middle_name", "last_name", "username", "email",
         "phone", "address1", "address2", "address3", "city", "state",
         "postal_code", "country", "ssn", "license_number", "passport_number"]

args = sys.argv[1:]
if not args:
    sys.exit(1)

raw = subprocess.run(["rbw", "get", "--raw", "--full"] + args,
                     capture_output=True, text=True)
if raw.returncode != 0:
    err = (raw.stderr or "unknown error").strip().splitlines()
    msg = err[-1] if err else "unknown error"
    msg = msg.replace("rbw get: ", "")
    sys.stderr.write(raw.stderr)
    print(f"ERROR\t{msg[:160]}")      # visible in the field pane
    sys.exit(0)                        # rows, not a silent empty result

d = json.loads(raw.stdout or "{}")
data = d.get("data") or {}
rows = []


def add(label, val):
    if val is None:
        return
    val = str(val)
    if val.strip():
        rows.append((label, val))


seen = set()
for k in LOGIN + CARD + IDENT:
    if k in data and k not in seen:   # 'username' is in both LOGIN and IDENT
        seen.add(k)
        add(k.replace("_", " "), data[k])

for u in data.get("uris") or []:
    add("uri", (u or {}).get("uri"))

# Custom fields, which is where most people stash the interesting extras.
for f in d.get("fields") or []:
    add((f.get("name") or "field"), f.get("value"))

add("folder", d.get("folder"))
notes = d.get("notes")
if notes and notes.strip():
    # Keep notes on one row; newlines would break the TAB-delimited format.
    add("notes", notes.replace("\n", "  ⏎  "))

for label, val in rows:
    print(f"{label}\t{val}")
